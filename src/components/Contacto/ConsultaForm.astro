---
import { areas } from '../../data/areas';
import { nombrePaquete, paquetes } from '../../data/paquetes';
import { contacto } from '../../data/site';
---

<form class="form" novalidate data-form>
  <div class="form__row" data-form-field>
    <label for="f-area">Área <span aria-hidden="true">*</span></label>
    <select id="f-area" name="area" required aria-describedby="f-area-err">
      <option value="">Seleccione un área</option>
      {areas.map((a) => <option value={a.id}>{a.nombre}</option>)}
    </select>
    <p class="form__err" id="f-area-err" aria-live="polite"></p>
  </div>

  <div class="form__row" data-form-field data-paquete-row hidden>
    <label for="f-paquete">Paquete</label>
    <select id="f-paquete" name="paquete">
      <option value="">Aún no sé / quiero asesoría</option>
      {paquetes.map((p) => <option value={p.id}>{nombrePaquete(p)} · {p.descripcion}</option>)}
    </select>
  </div>

  <div class="form__row" data-form-field>
    <label for="f-nombre">Nombre <span aria-hidden="true">*</span></label>
    <input id="f-nombre" name="nombre" type="text" autocomplete="name" required aria-describedby="f-nombre-err" />
    <p class="form__err" id="f-nombre-err" aria-live="polite"></p>
  </div>

  <div class="form__split">
    <div class="form__row" data-form-field>
      <label for="f-correo">Correo <span aria-hidden="true">*</span></label>
      <input id="f-correo" name="correo" type="email" autocomplete="email" required aria-describedby="f-correo-err" />
      <p class="form__err" id="f-correo-err" aria-live="polite"></p>
    </div>
    <div class="form__row" data-form-field>
      <label for="f-celular">Celular <span aria-hidden="true">*</span></label>
      <input
        id="f-celular"
        name="celular"
        type="tel"
        inputmode="tel"
        autocomplete="tel"
        required
        pattern="[0-9 +()\-]{7,}"
        aria-describedby="f-celular-err"
      />
      <p class="form__err" id="f-celular-err" aria-live="polite"></p>
    </div>
  </div>

  <div class="form__row" data-form-field>
    <label for="f-mensaje">Cuéntenos su caso <span class="form__opt">(opcional)</span></label>
    <textarea id="f-mensaje" name="mensaje" rows="4"></textarea>
  </div>

  <div class="form__check" data-form-field>
    <input id="f-datos" name="datos" type="checkbox" required aria-describedby="f-datos-err" />
    <label for="f-datos">
      Autorizo el tratamiento de mis datos personales según la{' '}
      <a href="/politica-de-datos" target="_blank">Política de Tratamiento de Datos</a>.
    </label>
    <p class="form__err" id="f-datos-err" aria-live="polite"></p>
  </div>

  <div data-form-field>
    <button class="btn btn--primary form__submit" type="submit" data-submit>
      Solicitar consulta gratis
    </button>
    <p class="form__note">Su solicitud se envía directo a nuestro WhatsApp con total confidencialidad.</p>
  </div>

  <div class="form__alt" data-form-field>
    <a class="btn btn--ghost" href={contacto.whatsappLink} target="_blank" rel="noopener">WhatsApp directo</a>
    <a class="btn btn--ghost" href={`mailto:${contacto.email}`}>Escribir correo</a>
  </div>
</form>

<style>
  .form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: var(--ink-3);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .form__row {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .form__row[hidden] {
    display: none;
  }
  .form__split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  label {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--text);
  }
  label span[aria-hidden] {
    color: var(--sand);
  }
  .form__opt {
    color: var(--text-dim);
    font-weight: 400;
  }
  input,
  select,
  textarea {
    width: 100%;
    min-height: 48px;
    padding: 0.75rem 1rem;
    font: inherit;
    font-size: 16px; /* evita zoom en iOS */
    color: var(--text);
    background: var(--ink);
    border: 1px solid var(--line);
    border-radius: 10px;
    transition:
      border-color 0.3s var(--ease-out),
      box-shadow 0.4s var(--ease-out);
  }
  select {
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, var(--sand) 50%),
      linear-gradient(135deg, var(--sand) 50%, transparent 50%);
    background-position:
      calc(100% - 20px) 50%,
      calc(100% - 15px) 50%;
    background-size: 5px 5px;
    background-repeat: no-repeat;
    padding-right: 2.5rem;
  }
  textarea {
    resize: vertical;
    min-height: 110px;
  }
  input:hover,
  select:hover,
  textarea:hover {
    border-color: rgba(217, 217, 217, 0.3);
  }
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: none;
    border-color: var(--sand);
    box-shadow: 0 0 0 3px rgba(241, 209, 152, 0.18);
  }
  [aria-invalid='true'] {
    border-color: #e59a8a;
  }
  /* Pulso Sand cuando llega una preselección. */
  :global(.is-pulsing) {
    animation: pulse-sand 1.4s var(--ease-out) 2;
  }
  @keyframes pulse-sand {
    0% {
      box-shadow: 0 0 0 0 rgba(241, 209, 152, 0.6);
      border-color: var(--sand);
    }
    100% {
      box-shadow: 0 0 0 12px rgba(241, 209, 152, 0);
    }
  }
  .form__err {
    margin: 0;
    font-size: 13px;
    color: #f0b3a6;
  }
  .form__err:empty {
    display: none;
  }
  .form__check {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.4rem 0.75rem;
    align-items: start;
  }
  .form__check input {
    width: 20px;
    min-height: 20px;
    height: 20px;
    margin-top: 2px;
    padding: 0;
    accent-color: var(--sand);
  }
  .form__check label {
    font-size: 14px;
    letter-spacing: 0;
    font-weight: 400;
    line-height: 1.5;
    color: var(--text-dim);
  }
  .form__check a {
    color: var(--sand);
  }
  .form__check .form__err {
    grid-column: 2;
  }
  .form__submit {
    width: 100%;
    font-size: 16px;
    min-height: 56px;
  }
  .form__submit:hover {
    background: var(--sand);
    color: var(--ink);
  }
  .form__submit[disabled] {
    cursor: progress;
    opacity: 0.85;
  }
  .form__note {
    margin: 0.75rem 0 0;
    font-size: 13px;
    color: var(--text-dim);
    text-align: center;
  }
  .form__alt {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .form__alt .btn {
    font-size: 14px;
  }

  @media (max-width: 480px) {
    .form__split,
    .form__alt {
      grid-template-columns: 1fr;
    }
  }
</style>

<!-- Comportamiento: scripts/consulta-form.ts (se importa en pages/index.astro). -->
