---
/**
 * Yantra de fondo que el cursor "despierta".
 * Un yantra enorme, casi invisible, detrás de toda la página. Por donde pasa el cursor (o el dedo)
 * sus trazos se encienden en Sand con un borde azul y se vuelven a apagar despacio, como una estela.
 * Es un <canvas> fijo con mezcla `screen`: solo suma luz, nunca tapa el contenido.
 */
---

<canvas class="ycursor" data-ycursor aria-hidden="true"></canvas>

<style>
  .ycursor {
    position: fixed;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    mix-blend-mode: screen;
    opacity: 0;
    transition: opacity 1.6s var(--ease-out);
  }
  .ycursor.is-ready {
    opacity: 1;
  }
</style>

<script>
  import { introDone } from '../animations/setup';
  import { CIRCLES, GATES, INNER, OUTER, PETAL, PETALS, TRIANGLES, VIEWBOX } from '../data/yantra';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-ycursor]');
  const ctx = canvas?.getContext('2d');
  if (canvas && ctx) init(canvas, ctx);

  function init(canvas: HTMLCanvasElement, ctx: CanvasRenderingContext2D) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const coarse = window.matchMedia('(pointer: coarse)').matches;

    /* ---- Ajustes ---- */
    const LIFE = coarse ? 1600 : 1300; // ms que tarda en apagarse un punto de la estela
    const BASE_ALPHA = 0.07; // el yantra "dormido"
    const LIT_ALPHA = 0.8; // tope de brillo de los trazos encendidos
    const HAZE_ALPHA = 0.05; // halo muy suave alrededor del cursor
    const MAX_POINTS = 360;

    /* ---- Trazos del yantra como Path2D (unidades del viewBox) ---- */
    const strokes: { path: Path2D; rot: number }[] = [];
    for (const g of GATES) {
      strokes.push({ path: new Path2D(OUTER), rot: g.rot }, { path: new Path2D(INNER), rot: g.rot });
    }
    for (const r of CIRCLES) {
      const p = new Path2D();
      p.arc(0, 0, r, 0, Math.PI * 2);
      strokes.push({ path: p, rot: 0 });
    }
    for (const deg of PETALS) strokes.push({ path: new Path2D(PETAL), rot: deg });
    for (const pts of TRIANGLES) strokes.push({ path: new Path2D(`M ${pts.replaceAll(' ', ' L ')} Z`), rot: 0 });

    /* ---- Lienzos auxiliares ---- */
    const lit = document.createElement('canvas');
    const trail = document.createElement('canvas');
    const litCtx = lit.getContext('2d')!;
    const trailCtx = trail.getContext('2d')!;

    // Pincel: centro Sand cálido que se abre a un borde azul y se desvanece.
    const SPRITE = 256;
    const sprite = document.createElement('canvas');
    sprite.width = sprite.height = SPRITE;
    {
      const s = sprite.getContext('2d')!;
      const g = s.createRadialGradient(SPRITE / 2, SPRITE / 2, 0, SPRITE / 2, SPRITE / 2, SPRITE / 2);
      g.addColorStop(0, 'rgba(255, 232, 190, 1)');
      g.addColorStop(0.45, 'rgba(241, 209, 152, 0.7)');
      g.addColorStop(0.78, 'rgba(91, 124, 168, 0.22)');
      g.addColorStop(1, 'rgba(91, 124, 168, 0)');
      s.fillStyle = g;
      s.fillRect(0, 0, SPRITE, SPRITE);
    }

    let W = 0;
    let H = 0;
    let dpr = 1;
    let radius = 160;

    function resize() {
      W = window.innerWidth;
      H = window.innerHeight;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      radius = Math.max(110, Math.min(200, Math.min(W, H) * 0.2));
      for (const c of [canvas, lit, trail]) {
        c.width = Math.round(W * dpr);
        c.height = Math.round(H * dpr);
      }
      request();
    }

    /** Traza el yantra completo, centrado y del tamaño del fondo. */
    function strokeYantra(c: CanvasRenderingContext2D, width: number, rotation: number) {
      // Grande: cubre la pantalla por el lado largo sin perder el centro en el lado corto.
      const size = Math.max(Math.min(W, H) * 1.15, Math.max(W, H) * 0.8);
      const k = size / VIEWBOX;
      for (const s of strokes) {
        c.setTransform(dpr * k, 0, 0, dpr * k, (W / 2) * dpr, (H / 2) * dpr);
        c.rotate(((rotation + s.rot) * Math.PI) / 180);
        c.lineWidth = width / k;
        c.stroke(s.path);
      }
      c.setTransform(1, 0, 0, 1, 0, 0);
    }

    /* ---- Estela ---- */
    type Pt = { x: number; y: number; t: number; r: number };
    const points: Pt[] = [];
    let last: { x: number; y: number } | null = null;

    function paint(x: number, y: number, boost = 1) {
      const now = performance.now();
      const r = radius * boost;
      if (last) {
        const dx = x - last.x;
        const dy = y - last.y;
        const steps = Math.min(40, Math.floor(Math.hypot(dx, dy) / (r * 0.22)));
        for (let i = 1; i <= steps; i++) points.push({ x: last.x + (dx * i) / steps, y: last.y + (dy * i) / steps, t: now, r });
      }
      points.push({ x, y, t: now, r });
      if (points.length > MAX_POINTS) points.splice(0, points.length - MAX_POINTS);
      last = { x, y };
      request();
    }

    /* ---- Dibujo ---- */
    let raf = 0;
    let rotation = 0;
    function request() {
      if (!raf) raf = requestAnimationFrame(frame);
    }

    function frame() {
      raf = 0;
      const now = performance.now();
      while (points.length && now - points[0].t > LIFE) points.shift();

      ctx.clearRect(0, 0, canvas.width, canvas.height);

      // 1) El yantra dormido: apenas una sombra de líneas.
      ctx.globalAlpha = BASE_ALPHA;
      ctx.strokeStyle = 'rgb(217, 217, 217)';
      strokeYantra(ctx, 1, rotation);
      ctx.globalAlpha = 1;

      if (points.length) {
        // 2) La estela: manchas de luz que se abren y se apagan.
        trailCtx.clearRect(0, 0, trail.width, trail.height);
        for (const p of points) {
          const age = (now - p.t) / LIFE;
          const a = (1 - age) * (1 - age);
          const r = p.r * (0.75 + age * 0.5) * dpr;
          trailCtx.globalAlpha = a * 0.4;
          trailCtx.drawImage(sprite, p.x * dpr - r, p.y * dpr - r, r * 2, r * 2);
        }
        trailCtx.globalAlpha = 1;

        // 3) Solo los trazos del yantra toman el color de la estela (con un leve resplandor).
        litCtx.globalCompositeOperation = 'source-over';
        litCtx.clearRect(0, 0, lit.width, lit.height);
        litCtx.strokeStyle = '#fff';
        litCtx.globalAlpha = 0.16;
        strokeYantra(litCtx, 7, rotation);
        litCtx.globalAlpha = 1;
        strokeYantra(litCtx, 1.4, rotation);
        litCtx.globalCompositeOperation = 'source-in';
        litCtx.drawImage(trail, 0, 0);
        litCtx.globalCompositeOperation = 'source-over';

        ctx.globalAlpha = HAZE_ALPHA;
        ctx.drawImage(trail, 0, 0);
        ctx.globalAlpha = LIT_ALPHA;
        ctx.drawImage(lit, 0, 0);
        ctx.globalAlpha = 1;

        request();
      }
    }

    /* ---- Entrada ---- */
    window.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'touch') return; // el tacto se sigue con touch* (sigue vivo durante el scroll)
      paint(e.clientX, e.clientY);
    }, { passive: true });
    document.documentElement.addEventListener('pointerleave', () => (last = null));
    window.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'touch') paint(e.clientX, e.clientY, 1.25);
    }, { passive: true });

    window.addEventListener('touchstart', (e) => {
      const t = e.touches[0];
      if (!t) return;
      last = null;
      paint(t.clientX, t.clientY, 1.2);
    }, { passive: true });
    window.addEventListener('touchmove', (e) => {
      const t = e.touches[0];
      if (t) paint(t.clientX, t.clientY);
    }, { passive: true });
    window.addEventListener('touchend', () => (last = null), { passive: true });

    // Giro muy lento con el scroll: el fondo acompaña el recorrido sin distraer.
    if (!reduce) {
      window.addEventListener('scroll', () => {
        rotation = window.scrollY * 0.012;
        request();
      }, { passive: true });
    }

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(resize, 100);
    });

    resize();
    introDone.then(() => canvas.classList.add('is-ready'));
  }
</script>
