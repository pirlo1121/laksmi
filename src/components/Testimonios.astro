---
import { testimonios } from '../data/testimonios';
---

<section
  class="testi"
  id="testimonios"
  aria-roledescription="carrusel"
  aria-labelledby="testi-title"
  data-testi
>
  <div class="container testi__inner">
    <p class="eyebrow testi__eyebrow" id="testi-title">Lo que dicen nuestros clientes</p>

    <div class="testi__stage">
      <span class="testi__mark" aria-hidden="true">“</span>
      <button class="testi__arrow testi__arrow--prev" type="button" aria-label="Testimonio anterior" data-testi-prev>
        ←
      </button>
      <div class="testi__quotes" aria-live="polite" data-testi-live>
        {
          testimonios.map((t, i) => (
            <figure
              class:list={['quote', { 'is-active': i === 0 }]}
              role="group"
              aria-roledescription="testimonio"
              aria-label={`${i + 1} de ${testimonios.length}`}
              data-quote
            >
              <blockquote class="quote__text" data-quote-text>
                {t.texto}
              </blockquote>
              <figcaption class="quote__author">— {t.autor}</figcaption>
            </figure>
          ))
        }
      </div>
      <button class="testi__arrow testi__arrow--next" type="button" aria-label="Testimonio siguiente" data-testi-next>
        →
      </button>
    </div>

    <div class="testi__controls">
      <div class="testi__dots" role="group" aria-label="Elegir testimonio">
        {
          testimonios.map((t, i) => (
            <button
              class="testi__dot"
              type="button"
              aria-label={`Testimonio ${i + 1}: ${t.autor}`}
              aria-current={i === 0 ? 'true' : undefined}
              data-testi-dot
            >
              <span class="testi__fill" />
            </button>
          ))
        }
      </div>
      <button class="testi__pause" type="button" aria-pressed="false" data-testi-pause>
        <span class="off">Pausar</span><span class="on">Reanudar</span>
      </button>
    </div>
  </div>
</section>

<style>
  .testi {
    position: relative;
    background: var(--ink-2);
    min-height: 80vh;
    display: flex;
    align-items: center;
    padding-block: clamp(5rem, 10vw, 8rem);
    overflow: hidden;
  }
  .testi__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(2rem, 5vw, 3.5rem);
  }
  .testi__stage {
    position: relative;
    width: 100%;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(1rem, 4vw, 4rem);
  }
  .testi__mark {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -88%;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 20vw;
    line-height: 1;
    color: var(--sand);
    opacity: 0.15;
    pointer-events: none;
  }
  .testi__quotes {
    position: relative;
    display: grid;
  }
  .quote {
    grid-area: 1 / 1;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    text-align: center;
  }
  /* Con JS se muestra una cita a la vez; sin JS, todas apiladas. */
  :global(html.js) .quote:not(.is-active) {
    visibility: hidden;
  }
  :global(html:not(.js)) .quote {
    grid-area: auto;
    margin-bottom: 3rem;
  }
  .quote__text {
    margin: 0;
    max-width: 30ch;
    font-family: var(--font-display);
    font-weight: 300;
    font-style: italic;
    font-size: clamp(1.5rem, 3.2vw, 3.25rem);
    line-height: 1.18;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .quote__author {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--sand);
  }
  .testi__arrow {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: none;
    cursor: pointer;
    font-size: 18px;
    transition:
      border-color 0.3s var(--ease-out),
      color 0.3s var(--ease-out);
  }
  .testi__arrow:hover {
    border-color: var(--sand);
    color: var(--sand);
  }
  :global(html:not(.js)) .testi__arrow,
  :global(html:not(.js)) .testi__controls {
    display: none;
  }
  .testi__controls {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .testi__dots {
    display: flex;
    gap: 8px;
  }
  .testi__dot {
    position: relative;
    width: 40px;
    height: 24px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .testi__dot::before,
  .testi__fill {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 2px;
    margin-top: -1px;
    background: var(--line);
  }
  .testi__fill {
    background: var(--sand);
    transform: scaleX(0);
    transform-origin: left;
  }
  .testi__dot[aria-current='true'] .testi__fill {
    transform: scaleX(1);
  }
  .testi__pause {
    padding: 6px 14px;
    border: 1px solid var(--line);
    border-radius: var(--pill);
    background: none;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
    cursor: pointer;
  }
  .testi__pause .on,
  .testi__pause[aria-pressed='true'] .off {
    display: none;
  }
  .testi__pause[aria-pressed='true'] .on {
    display: inline;
  }
  @media (prefers-reduced-motion: reduce) {
    .testi__pause {
      display: none;
    }
  }

  @media (max-width: 767px) {
    .testi__stage {
      grid-template-columns: 1fr;
    }
    .testi__arrow {
      display: none;
    }
    .testi__mark {
      font-size: 40vw;
    }
    .quote__text {
      font-size: 6vw;
    }
  }
</style>

<!-- Comportamiento: scripts/testimonios.ts (se importa en pages/index.astro). -->
