---
import { getImage, Image } from 'astro:assets';
import poster from '../../assets/brand/poster-socios-v4.jpg';
import { equipo } from '../../data/equipo';
import Yantra from '../Yantra.astro';
import PerfilPanel from './PerfilPanel.astro';

// El video de los socios (1280×720, 4.4 s, bucle limpio). El póster es su primer cuadro.
const posterImg = await getImage({ src: poster, format: 'webp', width: 1280 });

const conBio = equipo.filter((m) => m.bio.length > 0);
---

<section class="equipo" id="equipo" aria-labelledby="equipo-title" data-equipo>
  <div class="equipo__hero">
    <!-- Transición "la puerta se abre": el marco arranca recortado sobre el yantra del video y se abre. -->
    <div class="equipo__frame" aria-hidden="true" data-equipo-frame>
      <video
        class="equipo__video"
        muted
        loop
        playsinline
        preload="none"
        data-poster={posterImg.src}
        width="1280"
        height="720"
        data-equipo-video
      >
        <source src="/video/socios-v4.mp4" type="video/mp4" />
      </video>
      <div class="equipo__shade"></div>
    </div>
    <div class="equipo__gate" aria-hidden="true" data-equipo-gate>
      <Yantra class="equipo__gate-yantra" />
    </div>
    <header class="equipo__head container">
      <p class="eyebrow">Quiénes están de su lado</p>
      <h2 class="display equipo__title" id="equipo-title">
        <span class="mask"><span class="line">El</span></span>
        <span class="mask"><span class="light">Equipo</span></span>
      </h2>
      <p class="equipo__sub">Socios y abogados</p>
    </header>
  </div>

  <div class="container">
    <ul class="equipo__grid" role="list" data-equipo-grid>
      {
        equipo.map((m) => {
          const Tag = m.bio.length ? 'button' : 'div';
          return (
            <li class="miembro" data-miembro>
              <Tag
                class="miembro__card"
                {...(m.bio.length
                  ? {
                      type: 'button',
                      'aria-expanded': 'false',
                      'aria-controls': `perfil-${m.id}`,
                      'data-perfil-open': m.id,
                    }
                  : {})}
              >
                <span class="miembro__photo">
                  <Image
                    src={m.foto}
                    alt={`Retrato de ${m.nombre}`}
                    widths={[360, 600]}
                    sizes="(max-width: 767px) 50vw, 25vw"
                    loading="lazy"
                  />
                </span>
                <span class="miembro__name">{m.nombre}</span>
                <span class="miembro__role">{m.cargo}</span>
                {m.bio.length > 0 && (
                  <span class="miembro__more">
                    Ver perfil <span aria-hidden="true">+</span>
                  </span>
                )}
              </Tag>
            </li>
          );
        })
      }
    </ul>
  </div>

  <div class="equipo__panels">
    {conBio.map((m) => <PerfilPanel miembro={m} />)}
  </div>
</section>

<style>
  .equipo {
    position: relative;
    padding-bottom: clamp(4rem, 10vw, 8rem);
  }
  .equipo__hero {
    position: relative;
    height: min(90vh, 56.25vw + 10vh);
    min-height: 460px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }
  .equipo__frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .equipo__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
  }
  /* Yantra de la marca que se posa sobre el yantra del video al empezar la transición. */
  .equipo__gate {
    position: absolute;
    left: 0;
    top: 0;
    pointer-events: none;
    visibility: hidden;
  }
  .equipo__gate :global(.equipo__gate-yantra) {
    width: 100%;
    height: 100%;
    color: var(--sand);
    --yantra-stroke: 1.5px;
    filter: drop-shadow(0 0 8px rgba(241, 209, 152, 0.35));
  }
  .equipo__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, var(--ink) 0%, rgba(10, 14, 21, 0.2) 30%, rgba(10, 14, 21, 0.3) 60%, var(--ink) 100%),
      linear-gradient(90deg, rgba(10, 14, 21, 0.7) 0%, transparent 60%);
  }
  .equipo__head {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-bottom: clamp(2rem, 6vw, 5rem);
  }
  .equipo__title {
    font-size: clamp(3.5rem, 11vw, 11rem);
  }
  .equipo__sub {
    margin: 0;
    font-size: 18px;
    color: var(--text-dim);
  }

  .equipo__grid {
    --gap: clamp(1rem, 2vw, 2rem);
    --branch: 2.5rem;
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gap);
    margin: calc(clamp(2rem, 5vw, 4rem) + var(--branch)) 0 clamp(2rem, 5vw, 4rem);
    padding: 0;
    list-style: none;
  }
  /* Rama del hilo: baja por el centro, se abre en horizontal y llega a cada integrante. */
  .equipo__grid::before {
    content: '';
    position: absolute;
    top: calc(var(--branch) * -1);
    left: calc((100% - 3 * var(--gap)) / 8);
    right: calc((100% - 3 * var(--gap)) / 8);
    height: 1px;
    background: var(--sand);
    opacity: 0.6;
    transform: scaleX(var(--branch-p, 1));
    transition: transform 1.1s var(--ease-out);
  }
  .equipo__grid::after {
    content: '';
    position: absolute;
    left: 50%;
    top: calc(var(--branch) * -1);
    width: 9px;
    height: 9px;
    translate: -50% -50%;
    rotate: 45deg;
    background: var(--sand);
  }
  .miembro {
    position: relative;
  }
  .miembro::before {
    content: '';
    position: absolute;
    left: 50%;
    top: calc(var(--branch) * -1);
    width: 1px;
    height: var(--branch);
    background: var(--sand);
    opacity: 0.6;
    transform: scaleY(var(--branch-p, 1));
    transform-origin: top;
    transition: transform 0.6s var(--ease-out) 0.7s;
  }
  :global(html.js) .equipo__grid:not(.is-linked) {
    --branch-p: 0;
  }
  .miembro__card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    text-align: left;
  }
  button.miembro__card {
    cursor: pointer;
  }
  .miembro__photo {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 4px;
    margin-bottom: 1rem;
    background: var(--ink-3);
  }
  .miembro__photo::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--sand);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease-out);
  }
  .miembro__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    transition:
      filter 0.6s var(--ease-out),
      transform 0.8s var(--ease-out);
  }
  .miembro__card:hover .miembro__photo :global(img),
  .miembro__card[aria-expanded='true'] .miembro__photo :global(img) {
    filter: grayscale(0);
    transform: scale(1.03);
  }
  .miembro__card:hover .miembro__photo::after,
  .miembro__card[aria-expanded='true'] .miembro__photo::after {
    transform: scaleX(1);
  }
  .miembro__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.1rem, 1.6vw, 1.375rem);
    line-height: 1.15;
  }
  .miembro__role {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sand);
  }
  .miembro__more {
    margin-top: 0.5rem;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-dim);
    transition: color 0.3s var(--ease-out);
  }
  .miembro__card:hover .miembro__more {
    color: var(--sand);
  }

  @media (max-width: 767px) {
    /* Móvil: el video completo en 16:9 (se ven los dos socios) y el título debajo. */
    .equipo__hero {
      height: auto;
      min-height: 0;
      display: block;
    }
    .equipo__frame {
      position: relative;
      aspect-ratio: 16 / 9;
    }
    .equipo__head {
      padding-top: 2rem;
      padding-bottom: 0;
      background: var(--ink); /* el hilo pasa por detrás del título */
    }
    .equipo__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 2.5rem;
    }
    .equipo__grid::before {
      left: calc((100% - var(--gap)) / 4);
      right: calc((100% - var(--gap)) / 4);
    }
    .miembro:nth-child(n + 3)::before {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .miembro__photo :global(img) {
      filter: none;
    }
  }
</style>

<!-- Comportamiento: scripts/equipo.ts (se importa en pages/index.astro). -->
