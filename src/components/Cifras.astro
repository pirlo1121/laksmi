---
import { cifras, site } from '../data/site';
---

<!-- Inicio del hilo: la firma y sus cifras. El hilo nace en la partícula y baja por el centro. -->
<section class="firma" aria-labelledby="firma-title" data-cifras>
  <div class="firma__start" aria-hidden="true" data-thread-start>
    <span class="firma__spark"></span>
  </div>

  <header class="firma__head">
    <p class="eyebrow">La firma</p>
    <h2 class="firma__title" id="firma-title">Cada historia comienza con una decisión.</h2>
    <p class="firma__lead">{site.nombre} · {site.marca}</p>
  </header>

  <div class="container">
    <ul class="cifras__grid" role="list" aria-label="La firma en cifras">
      {
        cifras.map((c) => (
          <li class="cifras__cell">
            <strong
              class:list={['cifras__num', { 'is-accent': c.texto }]}
              data-count={c.valor ?? undefined}
              data-prefix={c.prefijo}
              data-text={c.texto ? '' : undefined}
            >
              {c.texto ?? `${c.prefijo}${c.valor}`}
            </strong>
            <span class="cifras__bar" aria-hidden="true" />
            <span class="label cifras__label">{c.etiqueta}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .firma {
    position: relative;
    padding-block: clamp(4rem, 12vh, 8rem) clamp(4rem, 10vh, 7rem);
  }
  .firma__start {
    display: grid;
    place-items: center;
    height: 90px;
    margin-bottom: clamp(1.5rem, 4vh, 2.5rem);
  }
  .firma__spark {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      #fff3dc 0 4px,
      rgba(241, 209, 152, 0.45) 5px,
      rgba(241, 209, 152, 0.1) 40%,
      transparent 70%
    );
    animation: firma-spark 3.2s ease-in-out infinite;
  }
  @keyframes firma-spark {
    50% {
      transform: scale(1.12);
    }
  }
  /* Tarjeta de título: el hilo pasa por detrás. */
  .firma__head {
    position: relative;
    width: fit-content;
    max-width: min(720px, calc(100% - 2 * var(--gutter)));
    margin: 0 auto clamp(3rem, 8vh, 5rem);
    padding: 1.25rem 1.5rem;
    background: var(--ink);
    text-align: center;
  }
  .firma__head .eyebrow {
    margin-bottom: 1rem;
  }
  .firma__title {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.8rem, 3.4vw, 3.2rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .firma__lead {
    margin: 0;
    color: var(--text-dim);
    font-size: 15px;
    line-height: 1.6;
  }

  /* Cifras simétricas a los lados del hilo: el hueco central queda libre para él. */
  .cifras__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: clamp(2rem, 6vw, 6rem);
    row-gap: 2.5rem;
  }
  .cifras__cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }
  .cifras__num {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(3rem, 6vw, 6.25rem);
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--text);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .cifras__num.is-accent {
    color: var(--sand);
    font-size: clamp(1.8rem, 3.6vw, 3.75rem); /* GRATIS es una palabra larga: mantiene la línea base de la fila */
    line-height: 1.2;
  }
  /* Odómetro: cada dígito es una columna 0–9 que gira hasta su valor. */
  .cifras__num :global(.odo) {
    display: inline-flex;
    align-items: flex-start;
  }
  .cifras__num :global(.odo__digit) {
    display: inline-block;
    height: 1em;
    overflow: hidden;
  }
  .cifras__num :global(.odo__col) {
    display: flex;
    flex-direction: column;
  }
  .cifras__num :global(.odo__col > span) {
    height: 1em;
    line-height: 1;
  }
  .cifras__num.is-odo {
    line-height: 1;
  }
  .cifras__bar {
    display: block;
    width: 56px;
    height: 2px;
    background: var(--sand);
  }
  .cifras__label {
    max-width: 14ch;
  }

  @media (max-width: 767px) {
    .cifras__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 3rem;
    }
    .cifras__num {
      font-size: 12vw;
    }
    .cifras__num.is-accent {
      font-size: 8.2vw;
    }
  }
</style>

<!-- Comportamiento: scripts/cifras.ts (se importa en pages/index.astro). -->
