---
import { cifras } from '../data/site';
---

<section class="cifras" aria-label="La firma en cifras" data-cifras>
  <span class="cifras__rule" aria-hidden="true"></span>
  <div class="container">
    <ul class="cifras__grid" role="list">
      {
        cifras.map((c) => (
          <li class="cifras__cell">
            <span class="cifras__line" aria-hidden="true" />
            <strong
              class:list={['cifras__num', { 'is-accent': c.texto }]}
              data-count={c.valor ?? undefined}
              data-prefix={c.prefijo}
              data-text={c.texto ? '' : undefined}
            >
              {c.texto ?? `${c.prefijo}${c.valor}`}
            </strong>
            <span class="cifras__bar" aria-hidden="true" />
            <span class="label cifras__label">{c.etiqueta}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .cifras {
    position: relative;
    padding-block: clamp(4rem, 10vh, 7rem);
    min-height: 48vh;
    display: flex;
    align-items: center;
  }
  .cifras__rule {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--sand);
    transform-origin: left;
  }
  .cifras__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .cifras__cell {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2rem clamp(1rem, 2vw, 2rem) 2rem;
  }
  .cifras__line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 1px;
    background: var(--line);
    transform-origin: top;
  }
  .cifras__cell:last-child::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    width: 1px;
    background: var(--line);
  }
  .cifras__num {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(3rem, 6vw, 6.25rem);
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--text);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .cifras__num.is-accent {
    color: var(--sand);
    font-size: clamp(1.8rem, 3.6vw, 3.75rem); /* GRATIS es una palabra larga: mantiene la línea base de la fila */
    line-height: 1.2;
  }
  /* Odómetro: cada dígito es una columna 0–9 que gira hasta su valor. */
  .cifras__num :global(.odo) {
    display: inline-flex;
    align-items: flex-start;
  }
  .cifras__num :global(.odo__digit) {
    display: inline-block;
    height: 1em;
    overflow: hidden;
  }
  .cifras__num :global(.odo__col) {
    display: flex;
    flex-direction: column;
  }
  .cifras__num :global(.odo__col > span) {
    height: 1em;
    line-height: 1;
  }
  .cifras__num.is-odo {
    line-height: 1;
  }
  .cifras__bar {
    display: block;
    width: 56px;
    height: 2px;
    background: var(--sand);
    transform-origin: left;
  }
  .cifras__label {
    max-width: 14ch;
  }

  @media (max-width: 767px) {
    .cifras {
      min-height: 0;
    }
    .cifras__grid {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 1rem;
    }
    .cifras__num {
      font-size: 12vw;
    }
    .cifras__num.is-accent {
      font-size: 8.2vw;
    }
    .cifras__cell:nth-child(2)::after {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      right: 0;
      width: 1px;
      background: var(--line);
    }
  }
</style>

<script>
  import { scene } from '../animations/setup';
  import { DUR, EASE } from '../animations/constants';
  import { split } from '../animations/reveal';

  const root = document.querySelector<HTMLElement>('[data-cifras]')!;

  /** Construye el odómetro de un número: prefijo fijo + una columna giratoria por dígito. */
  function buildOdometer(el: HTMLElement) {
    const end = el.dataset.count!;
    const prefix = el.dataset.prefix === '+' ? '+' : '';
    const digits = el.dataset.prefix === '0' ? end.padStart(2, '0') : end;
    const text = `${prefix}${digits}`;
    el.textContent = '';
    el.classList.add('is-odo');
    const sr = document.createElement('span');
    sr.className = 'sr-only';
    sr.textContent = text;
    const odo = document.createElement('span');
    odo.className = 'odo';
    odo.setAttribute('aria-hidden', 'true');
    if (prefix) odo.append(Object.assign(document.createElement('span'), { textContent: prefix, className: 'odo__prefix' }));
    const cols = [...digits].map((d, i) => {
      // Da una vuelta completa (más vueltas cuanto más a la derecha) y se detiene en su dígito.
      const laps = 1 + i;
      const seq = [...Array.from({ length: laps * 10 }, (_, k) => k % 10), Number(d)];
      const box = document.createElement('span');
      box.className = 'odo__digit';
      const col = document.createElement('span');
      col.className = 'odo__col';
      seq.forEach((n) => col.append(Object.assign(document.createElement('span'), { textContent: String(n) })));
      box.append(col);
      odo.append(box);
      return { col, steps: seq.length - 1, total: seq.length };
    });
    el.append(sr, odo);
    return cols;
  }

  scene(2, ({ gsap, c }) => {
    if (c.reduce) return; // valores finales, sin animar

    const tl = gsap.timeline({ scrollTrigger: { trigger: root, start: 'top 78%', once: true } });

    tl.from(root.querySelector('.cifras__rule'), { scaleX: 0, duration: DUR.slow, ease: EASE.enter }, 0);
    tl.from(root.querySelectorAll('.cifras__line'), { scaleY: 0, duration: 0.9, ease: EASE.heavy, stagger: 0.1 }, 0.1);

    const cells = [...root.querySelectorAll<HTMLElement>('.cifras__cell')];
    cells.forEach((cell, i) => {
      const at = 0.25 + i * 0.14;
      const num = cell.querySelector<HTMLElement>('.cifras__num')!;
      const bar = cell.querySelector('.cifras__bar');
      const label = cell.querySelector('.cifras__label');

      // La celda sube desde su máscara.
      tl.from(num, { yPercent: 40, autoAlpha: 0, duration: 0.8, ease: EASE.heavy }, at);

      if (num.dataset.count) {
        const cols = buildOdometer(num);
        cols.forEach(({ col, steps, total }, j) => {
          tl.fromTo(
            col,
            { yPercent: 0 },
            { yPercent: (-steps / total) * 100, duration: 1.5 + j * 0.35, ease: 'expo.out' },
            at + 0.05,
          );
        });
      } else {
        // GRATIS: las letras caen girando en 3D, una tras otra.
        const chars = split(num, 'chars', 'cifras__char');
        gsap.set(num, { perspective: 600 });
        tl.from(
          chars,
          { yPercent: 100, rotationX: -90, transformOrigin: '50% 100%', duration: 1, ease: EASE.enter, stagger: 0.06 },
          at + 0.05,
        );
      }

      // Barra Sand que se llena mientras el número gira.
      tl.from(bar, { scaleX: 0, duration: 1.6, ease: 'expo.out' }, at + 0.1);
      tl.from(label, { y: 16, autoAlpha: 0, duration: DUR.base, ease: EASE.heavy }, at + 0.3);
    });
  });
</script>
