---
import { areas } from '../../data/areas';
import AreaDoor from './AreaDoor.astro';
---

<section class="areas" id="areas" aria-labelledby="areas-title" data-areas>
  <div class="grid-lines" aria-hidden="true">
    {Array.from({ length: 12 }, () => <span />)}
  </div>

  <div class="container">
    <header class="areas__head">
      <div>
        <p class="eyebrow">Las protagonistas de la firma</p>
        <h2 class="display areas__title" id="areas-title">
          <span class="mask"><span class="line">Cuatro áreas</span></span>
        </h2>
      </div>
      <p class="areas__hint" aria-hidden="true">Elija una puerta <span>→</span></p>
    </header>

    <div class="doors" data-doors>
      {areas.map((area, i) => <AreaDoor area={area} total={areas.length} open={i === 0} />)}
    </div>
  </div>
</section>

<style>
  .areas {
    position: relative;
    padding-block: clamp(4rem, 10vw, 8rem);
  }
  .areas .grid-lines {
    opacity: 0.5;
  }
  .areas__head {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  .areas__head .eyebrow {
    margin-bottom: 1rem;
  }
  .areas__title {
    font-size: clamp(3rem, 9vw, 9rem);
  }
  .areas__hint {
    margin: 0;
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-dim);
    white-space: nowrap;
  }
  .areas__hint span {
    display: inline-block;
    color: var(--sand);
    animation: nudge 2.4s var(--ease-out) infinite;
  }
  @keyframes nudge {
    50% {
      transform: translateX(6px);
    }
  }
  .doors {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  @media (min-width: 1024px) {
    :global(html.js) .doors {
      flex-direction: row;
      gap: 12px;
      height: clamp(600px, 82vh, 780px);
    }
  }
  @media (max-width: 1023px) {
    .areas__hint {
      display: none;
    }
  }
  @media (max-width: 767px) {
    .areas__title {
      font-size: 14vw;
      line-height: 0.95; /* deja ver la tilde de ÁREAS en la segunda línea */
    }
  }
</style>

<script>
  import { loadGsap, prefersReducedMotion, registerAnchor, scene, scrollByNow, scrollToY } from '../../animations/setup';
  import { DUR, EASE } from '../../animations/constants';
  import { revealLines } from '../../animations/reveal';

  const root = document.querySelector<HTMLElement>('[data-areas]')!;
  const doors = [...root.querySelectorAll<HTMLElement>('[data-door]')];
  const tabs = doors.map((d) => d.querySelector<HTMLButtonElement>('[data-door-tab]')!);
  const panels = doors.map((d) => d.querySelector<HTMLElement>('[data-door-panel]')!);
  const rowMQ = window.matchMedia('(min-width: 1024px)');
  const isRow = () => rowMQ.matches;

  let active = 0;
  let busy = false;
  const visited = new Set<string>();

  /* ---- Puertas encendidas del yantra de progreso ---- */
  function markVisited(i: number) {
    if (i < 0) return;
    visited.add(doors[i].dataset.gate!);
    window.dispatchEvent(new CustomEvent('laksmi:area', { detail: { gates: [...visited] } }));
  }

  function setState(i: number, open: boolean) {
    doors[i].classList.toggle('is-open', open);
    tabs[i].setAttribute('aria-expanded', String(open));
    panels[i].inert = !open;
  }
  doors.forEach((_, i) => setState(i, i === active));

  /** Entrada escalonada del contenido de la puerta que se abre. */
  async function revealContent(i: number, delay: number) {
    if (prefersReducedMotion()) return;
    const { gsap } = await loadGsap();
    const items = doors[i].querySelectorAll('[data-door-item]');
    gsap.fromTo(
      items,
      { autoAlpha: 0, x: isRow() ? 40 : 0, y: isRow() ? 0 : 24 },
      { autoAlpha: 1, x: 0, y: 0, duration: 0.9, ease: EASE.enter, stagger: 0.06, delay, clearProps: 'all' },
    );
  }

  /* ---- Desktop: una puerta siempre abierta; el ancho lo anima CSS (flex-grow) ---- */
  function openRow(i: number) {
    if (i === active) return;
    if (active >= 0) setState(active, false);
    setState(i, true);
    active = i;
    markVisited(i);
    void revealContent(i, 0.3);
  }

  /* ---- Apilado (móvil/tablet): acordeón con altura animada ---- */
  async function toggleStack(i: number) {
    if (busy) return;
    const reduce = prefersReducedMotion();
    const closing = active;
    const opening = i === active ? -1 : i;
    busy = true;

    const { gsap } = await loadGsap();
    const dur = reduce ? 0 : 0.7;
    // La pestaña tocada queda quieta bajo el dedo mientras la otra puerta se cierra:
    // se compensa el scroll en cada cuadro (y se apaga el scroll anchoring del navegador).
    const anchor = doors[i];
    let anchorTop = anchor.getBoundingClientRect().top;
    const html = document.documentElement;
    html.style.overflowAnchor = 'none';
    const tl = gsap.timeline({
      defaults: { ease: 'power3.inOut' },
      onUpdate: () => {
        const top = anchor.getBoundingClientRect().top;
        const dy = top - anchorTop;
        if (Math.abs(dy) > 0.5) scrollByNow(dy);
        anchorTop = anchor.getBoundingClientRect().top;
      },
    });

    if (closing >= 0) {
      tl.to(panels[closing], { height: 0, duration: dur }, 0).add(() => {
        setState(closing, false);
        gsap.set(panels[closing], { clearProps: 'height' });
      });
    }
    if (opening >= 0) {
      setState(opening, true);
      tl.fromTo(panels[opening], { height: 0 }, { height: 'auto', duration: dur, clearProps: 'height' }, 0);
      void revealContent(opening, reduce ? 0 : 0.2);
    }
    active = opening;
    markVisited(opening);

    await tl.then();
    html.style.overflowAnchor = '';
    busy = false;
    // Si la puerta abierta quedó muy abajo, se acerca suavemente a la parte de arriba.
    if (opening >= 0) {
      const top = doors[opening].getBoundingClientRect().top;
      if (top < 60 || top > window.innerHeight * 0.4) scrollToY(top + window.scrollY - 84);
    }
    const { ScrollTrigger } = await loadGsap();
    ScrollTrigger.refresh();
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => (isRow() ? openRow(i) : void toggleStack(i)));
    // Flechas para moverse entre puertas.
    tab.addEventListener('keydown', (e) => {
      const keys: Record<string, number> = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 };
      if (!(e.key in keys)) return;
      e.preventDefault();
      const next = (i + keys[e.key] + tabs.length) % tabs.length;
      tabs[next].focus();
      if (isRow()) openRow(next);
    });
  });

  // En desktop, abrir al pasar el mouse un momento (sin tener que hacer clic).
  let hoverTimer = 0;
  doors.forEach((door, i) => {
    door.addEventListener('pointerenter', (e) => {
      if (!isRow() || e.pointerType !== 'mouse') return;
      hoverTimer = window.setTimeout(() => openRow(i), 380);
    });
    door.addEventListener('pointerleave', () => clearTimeout(hoverTimer));
  });

  // Al cruzar el breakpoint: sin alturas en línea y, en fila, siempre una puerta abierta.
  rowMQ.addEventListener('change', () => {
    panels.forEach((p) => (p.style.height = ''));
    if (isRow() && active < 0) {
      active = 0;
      setState(0, true);
    }
  });

  // Anclas #laboral, #civil, #seguridad-social, #penal: abren su puerta.
  doors.forEach((door, i) => {
    registerAnchor(`#${door.id}`, () => {
      if (isRow()) openRow(i);
      else if (active !== i) void toggleStack(i);
      const target = isRow() ? root : door;
      return target.getBoundingClientRect().top + window.scrollY - 60;
    });
  });

  // La primera puerta cuenta como visitada cuando la sección aparece.
  new IntersectionObserver(
    ([entry], obs) => {
      if (!entry.isIntersecting) return;
      markVisited(Math.max(active, 0));
      obs.disconnect();
    },
    { threshold: 0.3 },
  ).observe(root);

  /* ---- Entrada: las puertas suben desde su máscara, una tras otra ---- */
  scene(3, ({ gsap, c }) => {
    if (c.reduce) return;
    revealLines(gsap, root.querySelector('.areas__title')!, root, 'top 75%');
    gsap.from(root.querySelectorAll('.areas__head .eyebrow, .areas__hint'), {
      autoAlpha: 0,
      y: 16,
      duration: DUR.base,
      ease: EASE.heavy,
      scrollTrigger: { trigger: root, start: 'top 75%', once: true },
    });
    gsap.fromTo(
      doors,
      { clipPath: 'inset(100% 0% 0% 0%)', y: 80 },
      {
        clipPath: 'inset(0% 0% 0% 0%)',
        y: 0,
        duration: 1.3,
        ease: EASE.enter,
        stagger: 0.12,
        clearProps: 'clipPath,transform',
        scrollTrigger: { trigger: root.querySelector('[data-doors]'), start: 'top 85%', once: true },
      },
    );
    const first = doors[Math.max(active, 0)].querySelectorAll('[data-door-item]');
    gsap.from(first, {
      autoAlpha: 0,
      y: 30,
      duration: 1,
      ease: EASE.enter,
      stagger: 0.06,
      delay: 0.5,
      scrollTrigger: { trigger: root.querySelector('[data-doors]'), start: 'top 85%', once: true },
    });
  });
</script>
