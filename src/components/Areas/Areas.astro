---
/**
 * Áreas · índice sobre el hilo.
 * Cada área es un nodo del hilo con su tarjeta a un lado (alterna en desktop). La tarjeta lleva a
 * su capítulo de detalle más abajo, que el mismo hilo alcanza al bajar.
 */
import { areas } from '../../data/areas';
import { glosario } from '../../data/paquetes';
import Yantra from '../Yantra.astro';

const servicios = (a: (typeof areas)[number]) =>
  a.destacada ? `${glosario.length} coberturas` : `${a.grupos.reduce((n, g) => n + g.servicios.length, 0)} servicios`;
---

<section class="areas" id="areas" aria-labelledby="areas-title" data-areas>
  <header class="areas__head">
    <p class="eyebrow">Las protagonistas de la firma</p>
    <h2 class="display areas__title" id="areas-title">
      <span class="mask"><span class="line">Cuatro áreas</span></span>
    </h2>
    <p class="areas__intro">
      Una sola firma para lo laboral, lo familiar, su seguridad social y su defensa penal.
    </p>
  </header>

  <ol class="areas__list container" role="list">
    {
      areas.map((a, i) => (
        <li class:list={['anode', { 'anode--right': i % 2 === 1 }]} data-anode>
          <span class="anode__dot" aria-hidden="true">
            {a.numero}
          </span>
          <span class="anode__link" aria-hidden="true" />
          <a class="anode__card" href={`#${a.id}`}>
            <span class="anode__top">
              <span class="anode__count">{servicios(a)}</span>
              <Yantra class="anode__glyph" rotate={a.rotacion} lit={a.gate} />
            </span>
            <span class="anode__name display">
              <span class="line">{a.titulo[0]}</span>
              <span class="light">{a.titulo[1]}</span>
            </span>
            <span class="anode__summary">{a.resumen}</span>
            <span class="anode__go">
              Ver en detalle <span aria-hidden="true">↓</span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .areas {
    position: relative;
    padding-block: clamp(3rem, 8vh, 5rem) clamp(4rem, 10vh, 7rem);
  }
  /* Tarjeta de título centrada: el hilo pasa por detrás. */
  .areas__head {
    width: fit-content;
    max-width: calc(100% - 2 * var(--gutter));
    margin: 0 auto clamp(3rem, 8vh, 5rem);
    padding: 1.25rem 1.75rem;
    background: var(--ink);
    text-align: center;
  }
  .areas__head .eyebrow {
    margin-bottom: 1rem;
  }
  .areas__title {
    font-size: clamp(3rem, 7vw, 7rem);
  }
  .areas__intro {
    max-width: 38ch;
    margin: 1.25rem auto 0;
    color: var(--text-dim);
    line-height: 1.6;
  }

  .areas__list {
    list-style: none;
    margin: 0 auto;
    padding-block: 0;
    display: grid;
    gap: clamp(2.5rem, 7vh, 4.5rem);
  }
  /* Cada nodo: dos columnas con el hilo en el hueco central. */
  .anode {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: clamp(4rem, 10vw, 9rem);
    align-items: center;
  }
  .anode__dot {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--sand);
    border-radius: 50%;
    background: var(--ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.06em;
    color: var(--sand);
  }
  /* Conector del nodo a la tarjeta. */
  .anode__link {
    position: absolute;
    top: 50%;
    height: 1px;
    width: calc(clamp(4rem, 10vw, 9rem) / 2 - 24px);
    right: calc(50% + 24px);
    background: var(--sand);
    opacity: 0.6;
    transform-origin: right;
  }
  .anode--right .anode__link {
    right: auto;
    left: calc(50% + 24px);
    transform-origin: left;
  }
  .anode__card {
    grid-column: 1;
    position: relative;
    display: grid;
    gap: 0.9rem;
    padding: clamp(1.5rem, 2.5vw, 2.25rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--ink-2);
    color: var(--text);
    text-decoration: none;
    transition:
      border-color 0.4s var(--ease-out),
      transform 0.5s var(--ease-out);
  }
  .anode--right .anode__card {
    grid-column: 2;
  }
  .anode__card:hover,
  .anode__card:focus-visible {
    border-color: rgba(241, 209, 152, 0.5);
    transform: translateY(-3px);
  }
  .anode__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .anode__count {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .anode__card :global(.anode__glyph) {
    width: 36px;
    height: 36px;
    color: var(--text-dim);
    --gate-color: var(--text-dim);
    --yantra-stroke: 0.8px;
    --yantra-stroke-lit: 1.4px;
    transition: transform 0.7s var(--ease-out);
  }
  .anode__card:hover :global(.anode__glyph) {
    transform: rotate(45deg);
  }
  .anode__name {
    font-size: clamp(2rem, 3.4vw, 3.4rem);
    line-height: 0.9;
  }
  .anode__summary {
    color: var(--text-dim);
    font-size: 15px;
    line-height: 1.6;
  }
  .anode__go {
    font-size: 13px;
    font-weight: 600;
    color: var(--sand);
  }
  .anode__go span {
    display: inline-block;
    transition: transform 0.4s var(--ease-out);
  }
  .anode__card:hover .anode__go span {
    transform: translateY(3px);
  }

  /* Móvil: una columna; el nodo va sobre el hilo, encima de su tarjeta. */
  @media (max-width: 767px) {
    .areas__title {
      font-size: 13vw;
      line-height: 1.05;
    }
    .anode {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 1rem;
      justify-items: center;
    }
    .anode__dot {
      position: static;
      translate: none;
    }
    .anode__link {
      display: none;
    }
    .anode__card,
    .anode--right .anode__card {
      grid-column: 1;
      width: 100%;
    }
  }
</style>

<script>
  import { scene } from '../../animations/setup';
  import { DUR, EASE } from '../../animations/constants';
  import { revealLines } from '../../animations/reveal';

  const root = document.querySelector<HTMLElement>('[data-areas]')!;

  scene(3, ({ gsap, c }) => {
    if (c.reduce) return;
    revealLines(gsap, root.querySelector('.areas__title')!, root, 'top 75%');
    gsap.from(root.querySelectorAll('.areas__head .eyebrow, .areas__intro'), {
      autoAlpha: 0,
      y: 16,
      duration: DUR.base,
      ease: EASE.heavy,
      stagger: 0.1,
      scrollTrigger: { trigger: root, start: 'top 75%', once: true },
    });

    // Cada nodo se enciende cuando el hilo llega a él: punto → conector → tarjeta.
    root.querySelectorAll<HTMLElement>('[data-anode]').forEach((node) => {
      const right = node.classList.contains('anode--right');
      const tl = gsap.timeline({ scrollTrigger: { trigger: node, start: 'top 70%', once: true } });
      tl.from(node.querySelector('.anode__dot'), { scale: 0, autoAlpha: 0, duration: 0.6, ease: 'back.out(2)' }, 0)
        .from(node.querySelector('.anode__link'), { scaleX: 0, duration: 0.5, ease: 'power2.out' }, 0.25)
        .from(
          node.querySelector('.anode__card'),
          { autoAlpha: 0, x: c.desktop ? (right ? 40 : -40) : 0, y: c.desktop ? 0 : 24, duration: 0.9, ease: EASE.enter },
          0.35,
        );
    });
  }, root);
</script>
