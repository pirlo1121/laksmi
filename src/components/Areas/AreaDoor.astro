---
import type { Area } from '../../data/areas';
import { glosario } from '../../data/paquetes';
import Yantra from '../Yantra.astro';

interface Props {
  area: Area;
  total: number;
  open?: boolean;
}

const { area, total, open = false } = Astro.props;
const tabId = `puerta-${area.id}-tab`;
const panelId = `puerta-${area.id}-panel`;
---

<article class:list={['door', { 'is-open': open }]} id={area.id} data-door data-gate={area.gate}>
  <h3 class="door__heading">
    <button
      class="door__tab"
      type="button"
      id={tabId}
      aria-expanded={open ? 'true' : 'false'}
      aria-controls={panelId}
      data-door-tab
    >
      <span class="door__num">{area.numero}</span>
      <Yantra class="door__glyph" rotate={area.rotacion} lit={area.gate} />
      <span class="door__name">{area.nombre}</span>
      <span class="door__icon" aria-hidden="true"></span>
    </button>
  </h3>

  <div class="door__panel" id={panelId} role="region" aria-labelledby={tabId} data-door-panel>
    <div class="door__content">
      <Yantra class="door__watermark" rotate={area.rotacion} lit={area.gate} />
      <p class="eyebrow" data-door-item>
        Puerta {area.numero} / {String(total).padStart(2, '0')}
      </p>
      <p class="display door__title" aria-hidden="true" data-door-item>
        <span class="line">{area.titulo[0]}</span>
        <span class="light">{area.titulo[1]}</span>
      </p>
      <p class="door__summary" data-door-item>{area.resumen}</p>

      {
        area.destacada ? (
          <ul class="door__siglas" role="list" data-door-item>
            {glosario.map((g) => (
              <li>
                <strong>{g.sigla}</strong>
                <span>{g.significado}</span>
              </li>
            ))}
          </ul>
        ) : (
          <div class="door__groups">
            {area.grupos.map((g) => (
              <div class="door__group" data-door-item>
                <h4 class="door__group-title">{g.titulo}</h4>
                <ul role="list">
                  {g.servicios.map((s) => (
                    <li>{s}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        )
      }

      <div class="door__cta" data-door-item>
        {
          area.destacada ? (
            <a class="btn btn--outline" href="#paquetes">
              Ver paquetes <span class="arrow">→</span>
            </a>
          ) : (
            <a class="btn btn--outline" href="#contacto" data-area={area.id}>
              Consultar esta área <span class="arrow">→</span>
            </a>
          )
        }
      </div>
    </div>
  </div>
</article>

<style>
  /* ============ Base: puertas apiladas (móvil, tablet y sin JS) ============ */
  .door {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--ink-2);
    transition:
      background-color 0.6s var(--ease-out),
      border-color 0.6s var(--ease-out);
  }
  .door.is-open {
    background: var(--ink-3);
    border-color: rgba(241, 209, 152, 0.35);
  }
  .door__heading {
    margin: 0;
  }
  .door__tab {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    align-items: center;
    gap: 14px;
    width: 100%;
    min-height: 78px;
    padding: 16px 20px;
    border: 0;
    background: none;
    text-align: left;
    cursor: pointer;
  }
  .door__tab:focus-visible {
    outline-offset: -4px;
  }
  .door__num {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1rem;
    color: var(--sand);
  }
  .door__tab :global(.door__glyph) {
    width: 34px;
    height: 34px;
    color: rgba(241, 209, 152, 0.55);
    --yantra-stroke: 0.9px;
    --yantra-stroke-lit: 1.6px;
    transition: transform 0.9s var(--ease-out);
  }
  .door.is-open .door__tab :global(.door__glyph) {
    transform: rotate(90deg);
  }
  .door__name {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.35rem, 5.6vw, 2.25rem);
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    transition: color 0.4s var(--ease-out);
  }
  .door__tab:hover .door__name {
    color: var(--sand);
  }
  .door__icon {
    position: relative;
    width: 18px;
    height: 18px;
  }
  .door__icon::before,
  .door__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: var(--sand);
    transition: transform 0.6s var(--ease-out);
  }
  .door__icon::after {
    transform: rotate(90deg);
  }
  .door.is-open .door__icon::after {
    transform: rotate(0);
  }

  .door__panel {
    position: relative;
    overflow: hidden;
  }
  .door__content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.1rem;
    padding: 0.25rem 20px 1.75rem;
  }
  .door__content :global(.door__watermark) {
    position: absolute;
    right: -35%;
    bottom: -25%;
    width: 90%;
    aspect-ratio: 1;
    height: auto;
    color: var(--sand);
    opacity: 0.06;
    pointer-events: none;
    transform: scale(0.85) rotate(-20deg);
    transition: transform 1.4s var(--ease-out);
  }
  .door.is-open .door__content :global(.door__watermark) {
    transform: scale(1) rotate(0deg);
  }
  .door__content > .eyebrow,
  .door__title {
    display: none; /* en apilado, el nombre ya está en la pestaña */
  }
  .door__title {
    font-size: clamp(2.2rem, min(4.4vw, 8vh), 4.75rem);
  }
  .door__summary {
    position: relative;
    margin: 0;
    max-width: 46ch;
    font-size: clamp(1rem, min(1.35vw, 2.3vh), 1.2rem);
    line-height: 1.5;
  }
  .door__groups {
    position: relative;
    display: grid;
    gap: 1.5rem;
    width: 100%;
  }
  .door__group-title {
    margin: 0 0 0.4rem;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--sand);
  }
  .door__group ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .door__group li {
    position: relative;
    padding: clamp(6px, 0.8vh, 8px) 0 clamp(6px, 0.8vh, 8px) 20px;
    border-bottom: 1px solid var(--line);
    font-size: clamp(14px, 1.75vh, 15px);
    line-height: 1.35;
  }
  .door__group li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.1em;
    width: 10px;
    height: 1px;
    background: var(--sand);
  }
  .door__siglas {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, auto);
    justify-content: start;
    gap: 1rem 2.5rem;
  }
  .door__siglas li {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .door__siglas strong {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2.4rem, min(4.5vw, 8vh), 4.5rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
  }
  .door__siglas span {
    font-size: 13px;
    color: var(--text-dim);
  }
  .door__cta {
    position: relative;
    padding-top: 0.25rem;
  }

  /* Con JS: las puertas cerradas ocultan su panel (el JS anima la altura). */
  @media (max-width: 1023px) {
    :global(html.js) .door:not(.is-open) .door__panel {
      height: 0;
      visibility: hidden;
    }
  }

  /* ============ Desktop: cuatro puertas en fila que se abren de lado ============ */
  @media (min-width: 1024px) {
    :global(html.js) .door {
      flex: 1 1 0;
      min-width: 0;
      transition:
        flex-grow 1s cubic-bezier(0.77, 0, 0.18, 1),
        background-color 0.6s var(--ease-out),
        border-color 0.6s var(--ease-out);
    }
    :global(html.js) .door.is-open {
      flex-grow: 5.5;
    }
    :global(html.js) .door:not(.is-open):hover {
      flex-grow: 1.25;
      background: #111926;
    }

    /* Pestaña cerrada: número arriba, glifo, nombre en vertical abajo. */
    :global(html.js) .door__tab {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      gap: 1.25rem;
      padding: 2rem 0 2.25rem;
      transition: opacity 0.4s var(--ease-out);
    }
    :global(html.js) .door__tab :global(.door__glyph) {
      width: 56px;
      height: 56px;
    }
    :global(html.js) .door__name {
      flex: 1;
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      font-size: clamp(1.4rem, 2vw, 2.1rem);
      white-space: nowrap;
    }
    :global(html.js) .door__icon {
      display: none;
    }
    :global(html.js) .door.is-open .door__tab {
      opacity: 0;
      pointer-events: none;
    }

    :global(html.js) .door__panel {
      position: absolute;
      inset: 0;
    }
    /* El contenido tiene el ancho de la puerta abierta: se revela al abrirse, sin reacomodar el texto. */
    :global(html.js) .door__content {
      position: absolute;
      inset: 0 auto 0 0;
      width: calc((min(100vw, var(--maxw)) - 2 * var(--gutter) - 36px) * 5.5 / 8.5);
      justify-content: center;
      gap: clamp(0.9rem, 2.2vh, 1.5rem);
      padding: clamp(2rem, 5vh, 3.5rem) clamp(2rem, 4vw, 3.5rem);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 0.3s var(--ease-out),
        visibility 0s 0.3s;
    }
    :global(html.js) .door.is-open .door__content {
      opacity: 1;
      visibility: visible;
      transition: opacity 0.6s var(--ease-out) 0.2s;
    }
    :global(html.js) .door__content > .eyebrow,
    :global(html.js) .door__title {
      display: block;
    }
    :global(html.js) .door__groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem;
    }
    :global(html.js) .door__siglas {
      grid-template-columns: repeat(4, auto);
    }
    :global(html.js) .door__content :global(.door__watermark) {
      right: -12%;
      bottom: -18%;
      width: 62%;
    }
  }
</style>
