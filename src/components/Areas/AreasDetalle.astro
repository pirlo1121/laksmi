---
/**
 * Áreas · el detalle, como capítulos del hilo.
 * Al bajar, el hilo llega al nodo de cada área y su capítulo se abre a un lado (alterna en desktop);
 * del otro lado queda su número grande. En móvil, nodo arriba y tarjeta completa debajo.
 * Todo el contenido está siempre en el DOM (bueno para SEO y lectores de pantalla).
 */
import { areas } from '../../data/areas';
import { glosario } from '../../data/paquetes';

const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="detalle" aria-labelledby="detalle-title" data-detalle>
  <header class="detalle__head">
    <p class="eyebrow">Las áreas en detalle</p>
    <h2 class="display detalle__title" id="detalle-title">
      <span class="mask"><span class="line">Cómo le</span></span>
      <span class="mask"><span class="light">acompañamos</span></span>
    </h2>
  </header>

  <div class="container detalle__list">
    {
      areas.map((a, i) => (
        <article
          class:list={['chap', { 'chap--right': i % 2 === 1 }]}
          id={a.id}
          aria-labelledby={`chap-${a.id}`}
          data-chap
          data-gate={a.gate}
        >
          <span class="chap__dot" aria-hidden="true">
            {a.numero}
          </span>
          <span class="chap__num" aria-hidden="true">
            {a.numero}
          </span>

          <div class="chap__card">
            <h3 class="display chap__title" id={`chap-${a.id}`}>
              <span class="line">{a.titulo[0]}</span>
              <span class="light">{a.titulo[1]}</span>
            </h3>
            <p class="chap__summary" data-chap-item>
              {a.resumen}
            </p>

            {a.destacada ? (
              <>
                <ul class="chap__siglas" role="list">
                  {glosario.map((g) => (
                    <li class="chap__sigla" data-chap-item>
                      <strong>{g.sigla}</strong>
                      <span>{g.significado}</span>
                    </li>
                  ))}
                </ul>
                <p class="chap__note" data-chap-item>
                  Para independientes y empresas: afiliación, aportes y novedades en un solo lugar, en paquetes claros y
                  con un precio desde el primer contacto.
                </p>
              </>
            ) : (
              a.grupos.map((g) => (
                <div class="chap__group">
                  <h4 class="chap__group-title" data-chap-item>
                    {g.titulo}
                    <span>{pad(g.servicios.length)}</span>
                  </h4>
                  <ol class="chap__services" role="list">
                    {g.servicios.map((s, k) => (
                      <li data-chap-item>
                        <span class="chap__i" aria-hidden="true">
                          {pad(k + 1)}
                        </span>
                        <span>{s}</span>
                      </li>
                    ))}
                  </ol>
                </div>
              ))
            )}

            <div class="chap__foot" data-chap-item>
              {a.destacada ? (
                <a class="btn btn--outline" href="#paquetes">
                  Ver paquetes <span class="arrow">→</span>
                </a>
              ) : (
                <a class="btn btn--outline" href="#contacto" data-area={a.id}>
                  Consultar esta área <span class="arrow">→</span>
                </a>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .detalle {
    position: relative;
    padding-block: clamp(3rem, 8vh, 5rem) clamp(4rem, 10vh, 7rem);
  }
  .detalle__head {
    width: fit-content;
    max-width: calc(100% - 2 * var(--gutter));
    margin: 0 auto clamp(3rem, 8vh, 5rem);
    padding: 1.25rem 1.75rem;
    background: var(--ink);
    text-align: center;
  }
  .detalle__head .eyebrow {
    margin-bottom: 1rem;
  }
  .detalle__title {
    font-size: clamp(2.6rem, 5.5vw, 5.5rem);
  }

  .detalle__list {
    display: grid;
    gap: clamp(4rem, 12vh, 8rem);
  }
  /* Capítulo: tarjeta a un lado del hilo, número grande al otro. */
  .chap {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: clamp(4rem, 10vw, 9rem);
    align-items: start;
    scroll-margin-top: calc(var(--nav-h) + 1rem);
  }
  .chap__dot {
    position: absolute;
    left: 50%;
    top: 0;
    translate: -50% 0;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 1px solid var(--sand);
    border-radius: 50%;
    background: var(--ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 14px;
    color: var(--sand);
    z-index: 1;
  }
  .chap__num {
    grid-column: 2;
    grid-row: 1;
    justify-self: start;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(6rem, 14vw, 13rem);
    line-height: 0.8;
    letter-spacing: -0.05em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(241, 209, 152, 0.25);
    user-select: none;
  }
  .chap--right .chap__num {
    grid-column: 1;
    justify-self: end;
  }
  .chap__card {
    grid-column: 1;
    grid-row: 1;
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.75rem, 3vw, 2.75rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--ink-2);
  }
  .chap--right .chap__card {
    grid-column: 2;
  }
  .chap__title {
    font-size: clamp(2.3rem, 4vw, 4.2rem);
  }
  .chap__summary {
    margin: 0;
    font-size: clamp(1.02rem, 1.3vw, 1.18rem);
    line-height: 1.55;
    color: var(--text);
  }
  .chap__group-title {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin: 0.5rem 0 0.25rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid var(--sand);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--sand);
  }
  .chap__group-title span {
    color: var(--text-dim);
    letter-spacing: 0.1em;
  }
  .chap__services {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .chap__services li {
    display: grid;
    grid-template-columns: 2.1rem 1fr;
    gap: 0.5rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 15px;
    line-height: 1.5;
  }
  .chap__i {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 12px;
    color: var(--text-dim);
    padding-top: 0.2em;
  }
  .chap__siglas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  .chap__sigla {
    display: grid;
    gap: 0.3rem;
    padding: 1.1rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .chap__sigla strong {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.6rem, 2.4vw, 2.2rem);
    line-height: 1;
    color: var(--sand);
  }
  .chap__sigla span {
    font-size: 13px;
    color: var(--text-dim);
  }
  .chap__note {
    margin: 0;
    color: var(--text-dim);
    line-height: 1.6;
  }
  .chap__foot {
    margin-top: 0.5rem;
  }

  /* Móvil / tablet: nodo arriba, tarjeta completa debajo; el hilo pasa por detrás. */
  @media (max-width: 899px) {
    .chap,
    .chap--right {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 1.25rem;
      justify-items: center;
    }
    .chap__dot {
      position: static;
      translate: none;
    }
    .chap__num {
      display: none;
    }
    .chap__card,
    .chap--right .chap__card {
      grid-column: 1;
      grid-row: auto;
      width: 100%;
    }
  }
</style>

<script>
  import { scene } from '../../animations/setup';
  import { EASE } from '../../animations/constants';

  const root = document.querySelector<HTMLElement>('[data-detalle]')!;
  const chapters = [...root.querySelectorAll<HTMLElement>('[data-chap]')];

  // Las puertas del yantra de progreso se encienden al recorrer cada área.
  const visited = new Set<string>();
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        visited.add((e.target as HTMLElement).dataset.gate!);
        window.dispatchEvent(new CustomEvent('laksmi:area', { detail: { gates: [...visited] } }));
      });
    },
    { rootMargin: '-45% 0px -45% 0px' },
  );
  chapters.forEach((c) => io.observe(c));

  scene(3.5, ({ gsap, c }) => {
    if (c.reduce) return;
    gsap.from(root.querySelectorAll('.detalle__title .line, .detalle__title .light'), {
      yPercent: 110,
      duration: 1.2,
      ease: EASE.enter,
      stagger: 0.1,
      scrollTrigger: { trigger: root, start: 'top 78%', once: true },
    });

    // Cuando el hilo llega al nodo: el punto se enciende y el capítulo se abre desde el hilo.
    chapters.forEach((el) => {
      const right = el.classList.contains('chap--right');
      const tl = gsap.timeline({ scrollTrigger: { trigger: el, start: 'top 65%', once: true } });
      tl.from(el.querySelector('.chap__dot'), { scale: 0, autoAlpha: 0, duration: 0.6, ease: 'back.out(2)' }, 0)
        .from(el.querySelector('.chap__num'), { autoAlpha: 0, x: right ? -30 : 30, duration: 1.1, ease: EASE.enter }, 0.1)
        .from(
          el.querySelector('.chap__card'),
          { autoAlpha: 0, x: c.desktop ? (right ? 50 : -50) : 0, y: c.desktop ? 0 : 30, duration: 0.9, ease: EASE.enter },
          0.2,
        )
        .from(el.querySelectorAll('.chap__title .line, .chap__title .light'), { autoAlpha: 0, y: 24, duration: 0.8, stagger: 0.08 }, 0.35)
        .from(el.querySelectorAll('[data-chap-item]'), { autoAlpha: 0, y: 14, duration: 0.5, stagger: 0.03 }, 0.5);
    });
  });
</script>
