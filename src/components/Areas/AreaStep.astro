---
import type { Area } from '../../data/areas';
import { glosario } from '../../data/paquetes';
import Yantra from '../Yantra.astro';

interface Props {
  area: Area;
  total: number;
}

const { area, total } = Astro.props;
const titleId = `area-${area.id}-title`;
---

<article class="step" id={area.id} data-step aria-labelledby={titleId}>
  <div class="step__aside" aria-hidden="true">
    <Yantra class="step__yantra" rotate={area.rotacion} lit={area.gate} />
    <span class="step__aside-num">{area.numero}</span>
  </div>

  <div class="step__body">
    <p class="eyebrow step__eyebrow" data-step-fade>
      Puerta {area.numero} / {String(total).padStart(2, '0')}
    </p>
    <h3 class="display step__title" id={titleId}>
      <span class="mask"><span class="line" data-step-line>{area.titulo[0]}</span></span>
      <span class="mask"><span class="light" data-step-line>{area.titulo[1]}</span></span>
    </h3>
    <p class="step__summary" data-step-fade>{area.resumen}</p>

    {
      area.destacada ? (
        <ul class="step__siglas" role="list" data-step-fade>
          {glosario.map((g) => (
            <li>
              <strong>{g.sigla}</strong>
              <span>{g.significado}</span>
            </li>
          ))}
        </ul>
      ) : (
        <div class="step__groups" data-step-fade>
          {area.grupos.map((g) => (
            <div class="step__group">
              <h4 class="step__group-title">{g.titulo}</h4>
              <ul role="list">
                {g.servicios.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )
    }

    <div class="step__cta" data-step-fade>
      {
        area.destacada ? (
          <a class="btn btn--outline" href="#paquetes">
            Ver paquetes <span class="arrow">→</span>
          </a>
        ) : (
          <a class="btn btn--outline" href="#contacto" data-area={area.id}>
            Consultar esta área <span class="arrow">→</span>
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  /* ---- Modo estático (sin JS, reduced motion, pantallas bajas) ---- */
  .step {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: clamp(2rem, 5vw, 5rem);
    padding-block: clamp(3rem, 7vw, 6rem);
    border-top: 1px solid var(--line);
  }
  .step__aside {
    position: relative;
    align-self: start;
    position: sticky;
    top: calc(var(--nav-h) + 2rem);
    display: grid;
    place-items: center;
  }
  .step__aside :global(.step__yantra) {
    width: min(100%, 320px);
    aspect-ratio: 1;
    color: var(--sand);
    opacity: 0.9;
    --gate-color: rgba(241, 209, 152, 0.35);
  }
  .step__aside-num {
    position: absolute;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 3.5rem;
    color: var(--text);
  }

  .step__body {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2.4vh, 1.75rem);
    min-width: 0;
  }
  .step__title {
    font-size: clamp(2.6rem, min(6vw, 9.5vh), 6.5rem);
  }
  .step__summary {
    margin: 0;
    max-width: 44ch;
    font-size: clamp(1rem, min(1.4vw, 2.4vh), 1.25rem);
    line-height: 1.5;
  }

  .step__groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }
  .step__group-title {
    margin: 0 0 0.5rem;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--sand);
  }
  .step__group ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .step__group li {
    position: relative;
    padding: clamp(4px, 0.8vh, 8px) 0 clamp(4px, 0.8vh, 8px) 20px;
    border-bottom: 1px solid var(--line);
    font-size: clamp(13px, 1.8vh, 15px);
    line-height: 1.35;
    color: var(--text);
  }
  .step__group li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.05em;
    width: 10px;
    height: 1px;
    background: var(--sand);
  }

  .step__siglas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, auto);
    justify-content: start;
    gap: 1rem clamp(1.5rem, 3vw, 3rem);
  }
  .step__siglas li {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .step__siglas strong {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2.5rem, min(5vw, 8vh), 5rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
  }
  .step__siglas span {
    font-size: 13px;
    color: var(--text-dim);
  }
  .step__cta {
    padding-top: 0.5rem;
  }

  /* ---- Modo fijado (lo activa el JS de Areas con .is-pinned) ---- */
  :global(.areas.is-pinned) .step {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    padding: 0;
    border: 0;
  }
  :global(.areas.is-pinned) .step__aside {
    display: none;
  }
</style>
