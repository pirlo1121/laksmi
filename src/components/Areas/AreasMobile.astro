---
import { areas } from '../../data/areas';
import { glosario } from '../../data/paquetes';
import Yantra from '../Yantra.astro';
---

<div class="am" data-areas-mobile>
  <Yantra class="am__yantra" />
  {
    areas.map((area, i) => (
      <details class="am__item" id={`m-${area.id}`} open={i === 0} data-am-item>
        <summary class="am__summary">
          <span class="am__num">{area.numero}</span>
          <span class="am__name">{area.nombre}</span>
          <span class="am__icon" aria-hidden="true" />
        </summary>
        <div class="am__content" data-am-content>
          <div class="am__inner">
            <p class="am__summary-text">{area.resumen}</p>
            {area.destacada ? (
              <ul class="am__siglas" role="list">
                {glosario.map((g) => (
                  <li>
                    <strong>{g.sigla}</strong> {g.significado}
                  </li>
                ))}
              </ul>
            ) : (
              area.grupos.map((g) => (
                <div class="am__group">
                  <h4>{g.titulo}</h4>
                  <ul role="list">
                    {g.servicios.map((s) => (
                      <li>{s}</li>
                    ))}
                  </ul>
                </div>
              ))
            )}
            {area.destacada ? (
              <a class="btn btn--outline" href="#paquetes">
                Ver paquetes <span class="arrow">→</span>
              </a>
            ) : (
              <a class="btn btn--outline" href="#contacto" data-area={area.id}>
                Consultar esta área <span class="arrow">→</span>
              </a>
            )}
          </div>
        </div>
      </details>
    ))
  }
</div>

<style>
  .am :global(.am__yantra) {
    width: 80px;
    height: 80px;
    color: var(--sand);
    margin-bottom: 2rem;
  }
  .am__item {
    border-top: 1px solid var(--line);
  }
  .am__item:last-child {
    border-bottom: 1px solid var(--line);
  }
  .am__summary {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 1.4rem 0;
    cursor: pointer;
    list-style: none;
  }
  .am__summary::-webkit-details-marker {
    display: none;
  }
  .am__num {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1rem;
    color: var(--sand);
  }
  .am__name {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 7vw;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }
  .am__icon {
    position: relative;
    width: 18px;
    height: 18px;
  }
  .am__icon::before,
  .am__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: var(--sand);
    transition: transform 0.4s var(--ease-out);
  }
  .am__icon::after {
    transform: rotate(90deg);
  }
  .am__item[open] .am__icon::after {
    transform: rotate(0);
  }
  .am__content {
    overflow: hidden;
  }
  .am__inner {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-bottom: 2rem;
    align-items: flex-start;
  }
  .am__summary-text {
    margin: 0;
    font-size: 17px;
    line-height: 1.5;
  }
  .am__group h4 {
    margin: 0 0 0.4rem;
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--sand);
  }
  .am__group ul,
  .am__siglas {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .am__group li,
  .am__siglas li {
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
    font-size: 15px;
  }
  .am__siglas strong {
    font-family: var(--font-display);
    font-weight: 900;
    color: var(--sand);
    margin-right: 0.5em;
  }
</style>

<script>
  import { loadGsap, prefersReducedMotion } from '../../animations/setup';

  // Altura animada con GSAP (0.5s). Sin GSAP o con reduced motion, <details> nativo.
  document.querySelectorAll<HTMLDetailsElement>('[data-am-item]').forEach((item) => {
    const summary = item.querySelector('summary')!;
    const content = item.querySelector<HTMLElement>('[data-am-content]')!;
    let busy = false;

    summary.addEventListener('click', async (e) => {
      if (prefersReducedMotion()) return;
      e.preventDefault();
      if (busy) return;
      busy = true;
      const { gsap, ScrollTrigger } = await loadGsap();
      const done = () => {
        busy = false;
        ScrollTrigger.refresh();
      };
      if (item.open) {
        gsap.to(content, {
          height: 0,
          duration: 0.5,
          ease: 'power3.inOut',
          onComplete: () => {
            item.open = false;
            gsap.set(content, { clearProps: 'height' });
            done();
          },
        });
      } else {
        item.open = true;
        gsap.fromTo(
          content,
          { height: 0 },
          { height: 'auto', duration: 0.5, ease: 'power3.out', clearProps: 'height', onComplete: done },
        );
      }
    });
  });
</script>
