---
/**
 * El hilo de toda la página.
 * Va de [data-thread-start] (el inicio, con la información de la firma) a [data-thread-end]
 * (el centro del logo final), por el centro de la pantalla y DETRÁS del contenido (z-index -1):
 * se ve donde la sección es transparente y pasa por detrás de los paneles con fondo.
 *
 * Su cabeza es un loto pequeño con un halo cálido. Cada bloque de la página espera en penumbra y se
 * ilumina cuando el loto lo alcanza: la flor alumbra el conocimiento de la firma.
 *
 * Rendimiento: el hilo se llena con scaleY (solo compositor), la cabeza es `sticky` a media pantalla
 * y la luz de los bloques es un IntersectionObserver + opacidad. Nada corre por cuadro.
 */
---

<div class="hilo" aria-hidden="true" data-hilo>
  <span class="hilo__fill" data-hilo-fill></span>
  <span class="hilo__head">
    <span class="hilo__halo"></span>
    <svg class="hilo__lotus" viewBox="-16 -16 32 32">
      <!-- pétalos exteriores, interiores y central (de atrás hacia adelante) -->
      <path d="M 0 7 C -9 7 -14.5 2 -15 -2.5 C -9 -3 -4 1.5 0 7 Z"></path>
      <path d="M 0 7 C 9 7 14.5 2 15 -2.5 C 9 -3 4 1.5 0 7 Z"></path>
      <path d="M 0 7 C -7 4 -10 -3 -9 -8.5 C -5 -6.5 -2 -1.5 0 7 Z"></path>
      <path d="M 0 7 C 7 4 10 -3 9 -8.5 C 5 -6.5 2 -1.5 0 7 Z"></path>
      <path class="hilo__lotus-core" d="M 0 7 C -4.2 1 -4 -7 0 -12.5 C 4 -7 4.2 1 0 7 Z"></path>
    </svg>
  </span>
</div>

<style>
  .hilo {
    position: absolute;
    z-index: -1;
    left: 50%;
    top: 0;
    width: 1px;
    height: 0; /* lo ajusta el JS */
    margin-left: -0.5px;
    background: rgba(241, 209, 152, 0.13);
    pointer-events: none;
  }
  .hilo__fill {
    position: absolute;
    inset: 0;
    background: var(--sand);
    box-shadow: 0 0 10px rgba(241, 209, 152, 0.5);
    transform-origin: top;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hilo__fill {
      transform: scaleY(0);
      will-change: transform;
    }
  }

  /* Cabeza: un loto pequeño que queda a media pantalla mientras el hilo recorre la página. */
  .hilo__head {
    position: sticky;
    top: 50vh;
    top: 50dvh;
    display: block;
    height: 0;
  }
  .hilo__halo {
    position: absolute;
    left: 50%;
    top: 0;
    width: 180px;
    height: 180px;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(241, 209, 152, 0.2) 0,
      rgba(241, 209, 152, 0.07) 35%,
      transparent 70%
    );
  }
  .hilo__lotus {
    position: absolute;
    left: 50%;
    top: 0;
    width: 30px;
    height: 30px;
    max-width: none; /* el contenedor mide 1px (el hilo) */
    translate: -50% -58%; /* la base del loto se posa sobre el hilo */
    overflow: visible;
  }
  .hilo__lotus path {
    fill: var(--ink);
    stroke: var(--sand);
    stroke-width: 1;
    stroke-linejoin: round;
  }
  .hilo__lotus .hilo__lotus-core {
    fill: rgba(241, 209, 152, 0.28);
  }
  :global(html:not(.js)) .hilo__head,
  .hilo:not(.is-placed) .hilo__head {
    display: none;
  }

  /* Penumbra → luz: los bloques se encienden al paso del loto. */
  :global(html.hilo-on [data-lumen]) {
    transition: opacity 1.1s var(--ease-out);
  }
  /* 0.8: el texto secundario (--text-dim) sigue pasando AA (4.5:1) sobre los fondos oscuros y las
     tarjetas (con 0.75 las de las áreas quedaban en 4.47). */
  :global(html.hilo-on [data-lumen]:not(.is-lit)) {
    opacity: 0.8;
  }
</style>

<!-- Comportamiento: scripts/hilo.ts (se importa en pages/index.astro). -->
