---
import { contacto } from '../data/site';
import Yantra from './Yantra.astro';
---

<a
  class="progreso"
  href={contacto.whatsappLink}
  target="_blank"
  rel="noopener"
  aria-label="Consulta gratis por WhatsApp"
  data-progreso
>
  <span class="progreso__tip" aria-hidden="true">Consulta gratis por WhatsApp</span>
  <Yantra class="progreso__yantra" />
  <svg class="progreso__wa" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
    <path
      d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2Zm0 18.15a8.2 8.2 0 0 1-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.23 8.23 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 4.54 0 8.24 3.7 8.24 8.24s-3.7 8.24-8.24 8.24Zm4.52-6.17c-.25-.12-1.47-.72-1.7-.8-.22-.09-.39-.13-.55.12-.17.25-.64.8-.78.97-.14.16-.29.18-.54.06-.25-.13-1.05-.39-1.99-1.23a7.43 7.43 0 0 1-1.38-1.72c-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.16.04-.31-.02-.43-.06-.13-.55-1.34-.76-1.83-.2-.48-.4-.42-.55-.42h-.48a.9.9 0 0 0-.66.31c-.23.25-.86.85-.86 2.07 0 1.21.88 2.39 1.01 2.55.12.17 1.74 2.66 4.22 3.73.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.47-.07 1.47-.6 1.68-1.18.21-.59.21-1.09.14-1.19-.06-.11-.22-.17-.47-.29Z"
    ></path>
  </svg>
</a>

<style>
  .progreso {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 700;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--text-dim);
    --gate-color: rgba(217, 217, 217, 0.35);
    --yantra-stroke: 1px;
    --yantra-stroke-lit: 1.6px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
    transition:
      opacity 0.6s var(--ease-out),
      visibility 0.6s,
      transform 0.6s var(--ease-out);
  }
  .progreso.is-visible,
  :global(html:not(.js)) .progreso {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .progreso :global(.progreso__yantra) {
    width: 44px;
    height: 44px;
    transition: transform 0.6s var(--ease-out);
  }
  .progreso:hover :global(.progreso__yantra) {
    transform: rotate(45deg);
  }
  .progreso__wa {
    display: none;
  }
  .progreso__tip {
    position: absolute;
    right: calc(100% + 12px);
    white-space: nowrap;
    padding: 8px 14px;
    border-radius: var(--pill);
    background: var(--ink-3);
    border: 1px solid var(--line);
    font-size: 13px;
    color: var(--text);
    opacity: 0;
    transform: translateX(6px);
    pointer-events: none;
    transition:
      opacity 0.3s var(--ease-out),
      transform 0.3s var(--ease-out);
  }
  .progreso:hover .progreso__tip,
  .progreso:focus-visible .progreso__tip {
    opacity: 1;
    transform: none;
  }

  /* Móvil: botón flotante de WhatsApp con los colores de la marca. */
  @media (max-width: 767px) {
    .progreso {
      right: 16px;
      bottom: 16px;
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: var(--ink-3);
      border: 1px solid var(--line);
      color: var(--sand);
    }
    .progreso :global(.progreso__yantra),
    .progreso__tip {
      display: none;
    }
    .progreso__wa {
      display: block;
      width: 26px;
      height: 26px;
    }
  }
</style>

<!-- Comportamiento: scripts/yantra-progreso.ts (se importa en pages/index.astro). -->
