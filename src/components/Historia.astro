---
/**
 * Historia: escenas 2–7 del storyboard como planos del hilo de la página (ver Hilo.astro).
 * Cada plano es de pantalla completa con un SVG pequeño que se anima una vez al llegar y se rebobina
 * al volver; solo la apertura del loto va atada al scroll (sticky de CSS, sin pin de JS).
 * Estilos compartidos en styles/film.css. Sin JS o con reduced-motion todo se ve completo.
 */
import '../styles/film.css';

const f = (n: number) => Math.round(n * 10) / 10;
type P = [number, number];

function rng(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = rng(11);
const between = (a: number, b: number) => a + (b - a) * rand();
const poly = (pts: P[], close = false) =>
  'M ' + pts.map(([x, y]) => `${f(x)} ${f(y)}`).join(' L ') + (close ? ' Z' : '');

/* Escena 2: obstáculos sobre el camino; al pasar el hilo se apartan hacia los lados. */
const obstaculos = Array.from({ length: 9 }, (_, i) => {
  const side = i % 2 ? 1 : -1;
  const cx = side * between(20, 120);
  const cy = -150 + i * 38;
  const kind = i % 3;
  let d: string;
  if (kind === 0) {
    d = poly(Array.from({ length: 3 }, () => [cx + between(-50, 50), cy + between(-40, 40)] as P), true);
  } else if (kind === 1) {
    d = poly(Array.from({ length: 6 }, () => [cx + between(-60, 60), cy + between(-30, 30)] as P));
  } else {
    const s = between(26, 44);
    const a = between(0, Math.PI / 2);
    d = poly(
      [0, 1, 2, 3].map((k) => {
        const t = a + (k * Math.PI) / 2;
        return [cx + (s / Math.SQRT2) * Math.cos(t), cy + (s / Math.SQRT2) * Math.sin(t)] as P;
      }),
      true,
    );
  }
  return { d, dx: side * between(90, 150) };
});

/* Escena 3: fragmentos que se ordenan en una estructura limpia a ambos lados del hilo. */
const fragmentos = [-150, -90, -30, 30, 90, 150].flatMap((ty) =>
  [-1, 1].map((side) => ({
    tx: side * 115,
    ty,
    x: between(-160, 160),
    y: between(-170, 170),
    r: between(-80, 80),
  })),
);
const conceptos = [
  { t: 'Seguridad', y: -135 },
  { t: 'Confianza', y: -45 },
  { t: 'Estrategia', y: 45 },
  { t: 'Protección', y: 135 },
];

/* Escena 4: el hilo gira sobre sí mismo (rosa de 8 lóbulos, pocos puntos). */
const rosa = poly(
  Array.from({ length: 241 }, (_, i) => {
    const th = Math.PI / 8 + (i / 240) * Math.PI * 2;
    const r = 150 * Math.cos(4 * th);
    return [r * Math.cos(th), r * Math.sin(th)] as P;
  }),
);

/* Escena 5: el loto y sus valores. */
const PETALO = 'M 0 0 C 58 -52 60 -140 0 -190 C -60 -140 -58 -52 0 0 Z';
const valores = [
  { t: 'Integridad', rot: 0, x: 0, y: -215 },
  { t: 'Excelencia', rot: 90, x: 200, y: 48 },
  { t: 'Justicia', rot: 180, x: 0, y: 232 },
  { t: 'Prosperidad', rot: 270, x: -200, y: 48 },
];

/* Escena 7: arquitectura (planos, edificios, documento, diagrama), todo conectado al centro. */
const BASE = 60;
const edif = [
  [-280, 34, 110], [-242, 44, 170], [-194, 30, 90], [-160, 52, 140],
] as const;
const edificios =
  `M -290 ${BASE} H -100 ` + edif.map(([x, w, h]) => `M ${x} ${BASE} V ${BASE - h} H ${x + w} V ${BASE}`).join(' ');
const ventanas = edif
  .flatMap(([x, w, h]) => Array.from({ length: Math.floor((h - 30) / 22) }, (_, k) => `M ${x + 8} ${BASE - 18 - k * 22} H ${x + w - 8}`))
  .join(' ');
const documento =
  'M 110 -90 H 210 L 236 -64 V 90 H 110 Z M 210 -90 V -64 H 236 ' +
  Array.from({ length: 6 }, (_, k) => `M 128 ${-46 + k * 20} H ${k === 5 ? 180 : 218}`).join(' ');
const diagrama =
  'M -44 150 H 44 V 182 H -44 Z M 0 182 V 204 M -120 204 H 120 M -120 204 V 222 M 0 204 V 222 M 120 204 V 222 ' +
  [-156, -36, 84].map((x) => `M ${x} 222 H ${x + 72} V 252 H ${x} Z`).join(' ');
const planos = Array.from({ length: 8 }, (_, i) => {
  const a = (i * Math.PI) / 4 + Math.PI / 8;
  return poly([[40 * Math.cos(a), 40 * Math.sin(a)], [290 * Math.cos(a), 290 * Math.sin(a)]]);
});
const conectores = ['M 0 0 C -40 0 -70 20 -100 20', 'M 0 0 C 40 0 80 0 110 0', 'M 0 0 C 0 60 0 110 0 150'];

const escenas = [
  { n: '01', t: 'El origen' },
  { n: '02', t: 'El camino' },
  { n: '03', t: 'La claridad' },
  { n: '04', t: 'Nacimiento del loto' },
  { n: '05', t: 'Apertura' },
  { n: '06', t: 'El centro' },
  { n: '07', t: 'Construcción' },
  { n: '08', t: 'Legado' },
  { n: '09', t: 'Cierre' },
];
---

<section class="film" id="historia" aria-labelledby="film-title" data-film>
  <h2 class="sr-only" id="film-title">Nuestra historia</h2>

  <!-- 02 · El camino -->
  <article class="shot shot--right" data-shot="camino">
    <div class="shot__visual" aria-hidden="true">
      <svg viewBox="-200 -200 400 400">
        {obstaculos.map((o) => <path class="v-chaos v-draw" d={o.d} data-obst data-dx={f(o.dx)} />)}
      </svg>
    </div>
    <div class="shot__text">
      <p class="shot__label"><span>—</span>{escenas[1].t}</p>
      <p class="shot__cap">Incluso en los escenarios más complejos existe un camino.</p>
    </div>
  </article>

  <!-- 03 · La claridad -->
  <article class="shot" data-shot="claridad">
    <div class="shot__visual" aria-hidden="true">
      <svg viewBox="-200 -200 400 400">
        {
          fragmentos.map((fr) => (
            <line
              class="v-frag"
              x1="-45"
              y1="0"
              x2="45"
              y2="0"
              transform={`translate(${fr.tx} ${fr.ty})`}
              data-frag
              data-x={f(fr.x)}
              data-y={f(fr.y)}
              data-r={f(fr.r)}
              data-tx={fr.tx}
              data-ty={fr.ty}
            />
          ))
        }
        {conceptos.map((c) => <rect class="v-node" x="-6" y={c.y - 6} width="12" height="12" transform={`rotate(45 0 ${c.y})`} data-node />)}
        {
          conceptos.map((c, i) => (
            <text class="v-concept" x={i % 2 ? 18 : -18} y={c.y + 5} text-anchor={i % 2 ? 'start' : 'end'} data-concept>
              {c.t}
            </text>
          ))
        }
      </svg>
    </div>
    <div class="shot__text">
      <p class="shot__label"><span>—</span>{escenas[2].t}</p>
      <p class="shot__cap">Transformamos la complejidad en claridad.</p>
      <ul class="sr-only">{conceptos.map((c) => <li>{c.t}</li>)}</ul>
    </div>
  </article>

  <!-- 04 · Nacimiento del loto -->
  <article class="shot shot--right" data-shot="loto">
    <div class="shot__visual" aria-hidden="true">
      <svg viewBox="-200 -200 400 400">
        <path class="v-thread v-draw" d={rosa} data-rosa></path>
      </svg>
    </div>
    <div class="shot__text">
      <p class="shot__label"><span>—</span>{escenas[3].t}</p>
      <p class="shot__cap">La solidez nace de una visión clara.</p>
    </div>
  </article>

  <!-- 05 · Apertura: un pétalo por paso de scroll (sticky de CSS, sin pin de JS) -->
  <article class="shot shot--stay" data-shot="apertura">
    <div class="shot__sticky">
      <div class="shot__visual" aria-hidden="true">
        <svg viewBox="-260 -260 520 520">
          <path class="v-thread v-rosa-faint" d={rosa}></path>
          {
            [45, 135, 225, 315].map((r) => (
              <g transform={`rotate(${r})`}>
                <path class="v-petal v-petal--in" d={PETALO} transform="scale(0.6)" data-petal-in />
              </g>
            ))
          }
          {
            valores.map((v) => (
              <g transform={`rotate(${v.rot})`}>
                <path class="v-petal" d={PETALO} data-petal />
              </g>
            ))
          }
          {
            valores.map((v) => (
              <text class="v-value" x={v.x} y={v.y} text-anchor="middle" data-value>
                {v.t}
              </text>
            ))
          }
        </svg>
      </div>
      <div class="shot__text">
        <p class="shot__label"><span>—</span>{escenas[4].t}</p>
        <ul class="sr-only" role="list">
          {valores.map((v) => <li>{v.t}</li>)}
        </ul>
      </div>
    </div>
  </article>

  <!-- 06 · El centro -->
  <article class="shot shot--right" data-shot="centro">
    <div class="shot__visual" aria-hidden="true">
      <svg viewBox="-260 -260 520 520">
        {
          [0, 90, 180, 270].map((r) => (
            <g transform={`rotate(${r})`}>
              <path class="v-petal v-petal--dim" d={PETALO} />
            </g>
          ))
        }
      </svg>
      <span class="shot__light" data-light></span>
    </div>
    <div class="shot__text">
      <p class="shot__label"><span>—</span>{escenas[5].t}</p>
      <p class="shot__cap">Protegemos aquello que tiene valor.</p>
    </div>
  </article>

  <!-- 07 · Construcción -->
  <article class="shot" data-shot="construccion">
    <div class="shot__visual shot__visual--wide" aria-hidden="true">
      <svg viewBox="-300 -300 600 600">
        <g class="v-plan">
          {planos.map((d) => <path class="v-draw" d={d} />)}
          <circle class="v-draw" r="180"></circle>
          <circle class="v-draw" r="280"></circle>
        </g>
        {conectores.map((d) => <path class="v-link v-draw" d={d} data-link />)}
        <path class="v-line v-draw" d={edificios} data-piece></path>
        <path class="v-line v-line--dim v-draw" d={ventanas} data-piece></path>
        <path class="v-line v-draw" d={documento} data-piece></path>
        <path class="v-line v-draw" d={diagrama} data-piece></path>
        <circle class="v-core" r="7"></circle>
      </svg>
    </div>
    <div class="shot__text">
      <p class="shot__label"><span>—</span>{escenas[6].t}</p>
      <p class="shot__cap">Soluciones legales diseñadas para crecer con usted.</p>
    </div>
  </article>

</section>

<style>
  .film {
    position: relative;
  }
</style>

<script>
  import { scene } from '../animations/setup';
  import { $, $$, shots } from '../animations/shot';

  const root = document.querySelector<HTMLElement>('[data-film]')!;
  const shot = (name: string) => root.querySelector<HTMLElement>(`[data-shot="${name}"]`)!;

  scene(3.2, ({ gsap, ScrollTrigger, c }) => {
    if (c.reduce) return; // todo visible y completo
    const { take, draw } = shots(gsap, ScrollTrigger);

    // camino: aparece el caos y se aparta para que el hilo pase sin romperse.
    take(shot('camino'), (tl) => {
      const obs = $$<SVGPathElement>(shot('camino'), '[data-obst]');
      draw(tl, obs, 0, 0.9, 0.06);
      obs.forEach((o) => tl.to(o, { x: +o.dataset.dx!, opacity: 0.55, duration: 1.4, ease: 'power2.inOut' }, 1.1));
    });

    // claridad: los fragmentos se ordenan y los conceptos nacen del hilo.
    take(shot('claridad'), (tl) => {
      const s = shot('claridad');
      $$<SVGLineElement>(s, '[data-frag]').forEach((el, i) => {
        const d = el.dataset;
        tl.fromTo(
          el,
          { x: +d.x!, y: +d.y!, rotation: +d.r!, autoAlpha: 0 },
          { x: +d.tx!, y: +d.ty!, rotation: 0, autoAlpha: 1, duration: 1.5, ease: 'power3.inOut' },
          0.1 + (i % 4) * 0.08,
        );
      });
      tl.from($$(s, '[data-node]'), { scale: 0, transformOrigin: '50% 50%', duration: 0.5, stagger: 0.15, ease: 'back.out(2)' }, 1.3);
      tl.from($$(s, '[data-concept]'), { autoAlpha: 0, x: (i) => (i % 2 ? -24 : 24), duration: 0.8, stagger: 0.15 }, 1.45);
    });

    // loto: el hilo gira sobre sí mismo y sugiere la flor.
    take(shot('loto'), (tl) => {
      draw(tl, $(shot('loto'), '[data-rosa]'), 0, 2.6);
    });

    // apertura: un pétalo por paso de scroll (único scrub de escena, sobre pocos elementos).
    {
      const s = shot('apertura');
      const petals = $$(s, '[data-petal]');
      const values = $$(s, '[data-value]');
      const tl = gsap.timeline({
        defaults: { ease: 'power2.out' },
        scrollTrigger: { trigger: s, start: 'top top', end: 'bottom bottom', scrub: 0.4 },
      });
      tl.from($$<HTMLElement>(s, '.shot__label'), { autoAlpha: 0, y: 20, duration: 0.4 }, 0);
      petals.forEach((p, i) => {
        const at = 0.3 + i;
        tl.fromTo(p, { scale: 0.05, autoAlpha: 0, transformOrigin: '50% 100%' }, { scale: 1, autoAlpha: 1, duration: 0.8 }, at)
          .fromTo(values[i], { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.5 }, at + 0.35);
      });
      tl.fromTo(
        $$(s, '[data-petal-in]'),
        { scale: 0, autoAlpha: 0, transformOrigin: '50% 100%' },
        { scale: 0.6, autoAlpha: 1, duration: 0.8, stagger: 0.1 },
        4.1,
      );
      tl.to({}, { duration: 0.4 });
    }

    // centro: la luz crece, absorbe y se asienta.
    take(shot('centro'), (tl) => {
      const light = $(shot('centro'), '[data-light]');
      tl.fromTo(light, { scale: 0.1, autoAlpha: 0 }, { scale: 1.9, autoAlpha: 1, duration: 1.4, ease: 'power2.out' }, 0).to(
        light,
        { scale: 1, duration: 1.2, ease: 'power2.inOut' },
        1.4,
      );
    });

    // construcción: planos → conexiones → edificios, documento y diagrama.
    take(shot('construccion'), (tl) => {
      const s = shot('construccion');
      draw(tl, $$(s, '.v-plan .v-draw'), 0, 1, 0.05);
      draw(tl, $$(s, '[data-link]'), 0.5, 0.8, 0.12);
      draw(tl, $$(s, '[data-piece]'), 0.9, 1.4, 0.18);
    });

  });
</script>
