---
import { Picture } from 'astro:assets';
import bogota from '../assets/brand/bogota.jpg';
import { site } from '../data/site';
import Yantra from './Yantra.astro';

// [PENDIENTE] imagen/video del hero en alta resolución (hoy 1280×720).
const title = 'LAKSMI';
---

<section class="hero" id="top" data-hero aria-labelledby="hero-title">
  <div class="hero__stage">
    <div class="hero__media" aria-hidden="true">
      <Picture
        src={bogota}
        formats={['avif', 'webp']}
        widths={[640, 960, 1280]}
        sizes="100vw"
        alt=""
        loading="eager"
        fetchpriority="high"
        class="hero__img"
        data-hero-img
      />
      <div class="hero__overlay"></div>
      <div class="hero__shade"></div>
    </div>

    <!-- Yantra en profundidad: un plano inclinado lejos, detrás del título (eje Z). -->
    <div class="hero__yantra-wrap" aria-hidden="true">
      <div class="hero__yantra-depth" data-hero-depth>
        <div class="hero__yantra-tilt" data-hero-tilt>
          <div class="hero__yantra-spin" data-hero-yantra-root>
            <div class="hero__glow"></div>
            <Yantra class="hero__echo hero__echo--2" />
            <Yantra class="hero__echo hero__echo--1" />
            <Yantra class="hero__yantra" data-hero-yantra="" />
          </div>
        </div>
      </div>
    </div>

    <div class="hero__content container">
      <p class="eyebrow hero__eyebrow" data-hero-fade>{site.ciudad}</p>
      <h1 class="display hero__title" id="hero-title" aria-label="LAKSMI Abogados — Abogados en Bogotá">
        <span class="hero__line1 mask" aria-hidden="true">
          {[...title].map((ch) => <span class="hero__char">{ch}</span>)}
        </span>
        <span class="hero__line2" aria-hidden="true">
          <span class="light hero__light">Abogados</span>
        </span>
      </h1>
    </div>

    <p class="hero__phrase" data-hero-fade>{site.fraseHero}</p>

    <div class="hero__bottom container">
      <p class="hero__lema" data-hero-fade>{site.lema}.</p>
      <a class="hero__chip" href="#contacto" data-hero-fade>
        <span class="hero__dot" aria-hidden="true"></span>
        Primera consulta gratis
      </a>
      <div class="hero__cue" aria-hidden="true" data-hero-fade>
        <span>Desplázate</span>
        <span class="hero__cue-line"><span data-hero-cue></span></span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 560px;
  }
  .hero__stage {
    position: relative;
    height: 100%;
    overflow: hidden;
    isolation: isolate;
  }
  .hero__media,
  .hero__media :global(picture) {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__media :global(.hero__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform-origin: 50% 60%;
  }
  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 14, 21, 0.4) 0%, rgba(10, 14, 21, 0.95) 100%);
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    background: var(--ink);
    opacity: 0;
  }

  .hero__yantra-wrap {
    position: absolute;
    inset: 0;
    pointer-events: none;
    perspective: 1000px;
    perspective-origin: 50% 30%;
  }
  .hero__yantra-depth {
    position: absolute;
    left: 77%;
    top: 66%;
    width: 60vh;
    height: 60vh;
    translate: -50% -50%;
    transform: translateZ(-420px);
    transform-style: preserve-3d;
  }
  .hero__yantra-tilt {
    width: 100%;
    height: 100%;
    transform: rotateX(64deg);
    transform-style: preserve-3d;
  }
  .hero__yantra-spin {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
  }
  .hero__yantra-spin > :global(*) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero__yantra-spin :global(.hero__yantra) {
    color: var(--sand);
    opacity: 0.95;
    --yantra-stroke: 1.4px;
    filter: drop-shadow(0 0 6px rgba(241, 209, 152, 0.35));
  }
  /* Ecos debajo del plano: le dan grosor, como un sello tallado. */
  .hero__yantra-spin :global(.hero__echo) {
    color: var(--sand);
    --yantra-stroke: 1px;
  }
  .hero__yantra-spin :global(.hero__echo--1) {
    transform: translateZ(-26px);
    opacity: 0.35;
  }
  .hero__yantra-spin :global(.hero__echo--2) {
    transform: translateZ(-52px);
    opacity: 0.14;
  }
  .hero__glow {
    border-radius: 50%;
    background: radial-gradient(circle, rgba(241, 209, 152, 0.2) 0%, rgba(241, 209, 152, 0.06) 40%, transparent 68%);
    transform: translateZ(-70px) scale(1.5);
  }
  /* Con JS el yantra espera su entrada (o la llegada del preloader). Salvavidas si el JS falla. */
  :global(html.js) .hero__yantra-spin {
    visibility: hidden;
    animation: hero-yantra-failsafe 0s 5.5s forwards;
  }
  @keyframes hero-yantra-failsafe {
    to {
      visibility: visible;
    }
  }

  .hero__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: var(--nav-h);
    pointer-events: none;
  }
  .hero__eyebrow {
    margin-bottom: 1.5rem;
  }
  .hero__title {
    font-size: 18vw;
  }
  .hero__line1 {
    display: block;
    white-space: nowrap;
  }
  .hero__char {
    display: inline-block;
  }
  .hero__line2 {
    display: block;
    overflow: hidden;
    padding: 0.04em 0.1em 0.12em 0;
  }
  .hero__light {
    font-size: 0.5em; /* 9vw */
    line-height: 1;
    padding-left: 0.08em;
  }

  .hero__phrase {
    position: absolute;
    right: var(--gutter);
    bottom: calc(clamp(1.5rem, 4vh, 3rem) + 7.5rem);
    max-width: 14ch;
    margin: 0;
    text-align: right;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.25rem, 2.4vw, 2.25rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .hero__bottom {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(1.5rem, 4vh, 3rem);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .hero__lema {
    margin: 0;
    font-size: 20px;
    color: var(--text);
  }
  .hero__chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px;
    border: 1px solid var(--line);
    border-radius: var(--pill);
    background: rgba(10, 14, 21, 0.5);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    margin-inline: auto 0;
    transition: border-color 0.3s var(--ease-out);
  }
  .hero__chip:hover {
    border-color: var(--sand);
  }
  .hero__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--sand);
    box-shadow: 0 0 0 0 rgba(241, 209, 152, 0.6);
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 10px rgba(241, 209, 152, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(241, 209, 152, 0);
    }
  }
  .hero__cue {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .hero__cue-line {
    position: relative;
    width: 1px;
    height: 56px;
    background: var(--line);
    overflow: hidden;
  }
  .hero__cue-line span {
    position: absolute;
    inset: 0;
    background: var(--sand);
    transform-origin: top;
    animation: cue 2.2s var(--ease-out) infinite;
  }
  @keyframes cue {
    0% {
      transform: scaleY(0);
      transform-origin: top;
    }
    50% {
      transform: scaleY(1);
      transform-origin: top;
    }
    51% {
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }

  @media (max-width: 767px) {
    .hero__title {
      font-size: 22vw;
    }
    /* Móvil: el plano flota en el cielo, sobre el título. */
    .hero__yantra-depth {
      left: 50%;
      top: 27%;
      width: 44vh;
      height: 44vh;
    }
    .hero__phrase {
      bottom: 9.5rem;
      font-size: 6.5vw;
    }
    .hero__lema {
      font-size: 17px;
    }
    .hero__bottom {
      flex-wrap: wrap;
    }
    .hero__chip {
      order: -1;
      margin: 0;
    }
    .hero__cue {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .hero__yantra-spin {
      visibility: visible;
    }
    .hero__cue {
      display: none;
    }
  }
</style>

<script>
  import { introDone, scene } from '../animations/setup';
  import { EASE } from '../animations/constants';

  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  const q = <T extends Element = HTMLElement>(s: string) => hero.querySelector<T>(s)!;
  const qa = (s: string) => hero.querySelectorAll<HTMLElement>(s);

  let entrancePlayed = false;

  scene(1, ({ gsap, c }) => {
    const img = q('.hero__img');
    const shade = q('.hero__shade');
    const depth = q('[data-hero-depth]');
    const tilt = q('[data-hero-tilt]');
    const spin = q('[data-hero-yantra-root]');
    const fades = qa('[data-hero-fade]');

    /* ---- Reduced motion: yantra 3D estático, solo un fade inicial ---- */
    if (c.reduce) {
      introDone.then(() => gsap.from(hero, { autoAlpha: 0, duration: 0.3 }));
      return;
    }

    const DEPTH = { z: -420, tilt: 64 };
    gsap.set(depth, { z: DEPTH.z });
    gsap.set(tilt, { rotationX: DEPTH.tilt, rotationY: 0 });

    /* ---- Entrada (timed), una sola vez ---- */
    if (!entrancePlayed) {
      entrancePlayed = true;
      const chars = qa('.hero__char');
      const light = q('.hero__light');
      const hadPreloader = !document.documentElement.classList.contains('no-preloader');
      gsap.set(chars, { yPercent: 110 });
      gsap.set(light, { clipPath: 'inset(0 100% 0 0)' });
      gsap.set(fades, { autoAlpha: 0, y: 20 });

      introDone.then(() => {
        const tl = gsap.timeline({ defaults: { ease: EASE.enter } });
        tl.to(chars, { yPercent: 0, duration: 1.2, stagger: 0.04 }, 0.15)
          .to(light, { clipPath: 'inset(0 0% 0 0)', duration: 1.2 }, 0.45)
          .to(fades, { autoAlpha: 1, y: 0, duration: 0.9, stagger: 0.08 }, 0.6);
        if (!hadPreloader) {
          // Sin preloader: el yantra llega desde el fondo mientras se traza.
          tl.set(spin, { visibility: 'visible' }, 0)
            .fromTo(depth, { z: -2200 }, { z: DEPTH.z, duration: 2.2, ease: 'expo.out' }, 0)
            .fromTo(spin.querySelectorAll('.y-draw'), { drawSVG: '0%' }, { drawSVG: '100%', duration: 1.6, ease: 'power2.inOut', stagger: 0.004 }, 0);
        }
      });
    }

    // Giro lento y continuo del plano.
    gsap.to(spin, { rotationZ: 360, duration: 90, ease: 'none', repeat: -1 });

    // Desktop: el plano se inclina un poco siguiendo el mouse.
    let onMove: ((e: PointerEvent) => void) | null = null;
    if (c.desktop && window.matchMedia('(pointer: fine)').matches) {
      const rx = gsap.quickTo(tilt, 'rotationX', { duration: 1.4, ease: 'power3.out' });
      const ry = gsap.quickTo(tilt, 'rotationY', { duration: 1.4, ease: 'power3.out' });
      onMove = (e) => {
        const nx = e.clientX / window.innerWidth - 0.5;
        const ny = e.clientY / window.innerHeight - 0.5;
        rx(DEPTH.tilt - ny * 10);
        ry(nx * 14);
      };
      hero.addEventListener('pointermove', onMove);
    }

    /* ---- Salida: sin pin; la ciudad se acerca y el yantra se hunde en Z ---- */
    const tl = gsap.timeline({
      defaults: { ease: EASE.scrub },
      scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: true },
    });
    tl.fromTo(img, { scale: 1 }, { scale: c.desktop ? 1.2 : 1.1 }, 0);
    tl.fromTo(shade, { opacity: 0 }, { opacity: 0.6 }, 0);
    tl.fromTo(depth, { z: DEPTH.z, y: 0 }, { z: DEPTH.z - 900, y: c.desktop ? -60 : -30, immediateRender: false }, 0);

    return () => {
      if (onMove) hero.removeEventListener('pointermove', onMove);
    };
  });
</script>
