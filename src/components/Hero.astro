---
import { Picture } from 'astro:assets';
import bogota from '../assets/brand/bogota-hd.jpg';
import { site } from '../data/site';

// Foto: Dan Gold, «Bogotá city night desde Monserrate» — CC BY-SA 4.0, Wikimedia Commons (original 5506×3098).
const title = 'LAKSMI';
---

<section class="hero" id="top" data-hero aria-labelledby="hero-title">
  <div class="hero__stage">
    <div class="hero__media" aria-hidden="true" data-hero-media>
      <Picture
        src={bogota}
        formats={['avif', 'webp']}
        widths={[640, 960, 1280, 1920, 2560, 3200, 3840]}
        quality={82}
        sizes="(max-aspect-ratio: 16/9) 178vh, 100vw"
        alt=""
        loading="eager"
        fetchpriority="high"
        class="hero__img"
        data-hero-img
      />
      <div class="hero__overlay"></div>
      <div class="hero__shade"></div>
    </div>

    <div class="hero__content container">
      <p class="eyebrow hero__eyebrow" data-hero-fade>{site.ciudad}</p>
      <h1 class="display hero__title" id="hero-title" aria-label="LAKSMI Abogados — Abogados en Bogotá">
        <span class="hero__line1 mask" aria-hidden="true">
          {[...title].map((ch) => <span class="hero__char">{ch}</span>)}
        </span>
        <span class="hero__line2" aria-hidden="true">
          <span class="light hero__light">Abogados</span>
        </span>
      </h1>
    </div>

    <p class="hero__phrase" data-hero-fade>{site.fraseHero}</p>

    <div class="hero__bottom container">
      <p class="hero__lema" data-hero-fade>{site.lema}.</p>
      <a class="hero__chip" href="#contacto" data-hero-fade>
        <span class="hero__dot" aria-hidden="true"></span>
        Primera consulta gratis
      </a>
      <div class="hero__cue" aria-hidden="true" data-hero-fade>
        <span>Desplázate</span>
        <span class="hero__cue-line"><span data-hero-cue></span></span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 560px;
  }
  .hero__stage {
    position: relative;
    height: 100%;
    overflow: hidden;
    isolation: isolate;
  }
  .hero__media,
  .hero__media :global(picture) {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__media :global(.hero__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 60%;
    transform-origin: 50% 60%;
  }
  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 14, 21, 0.4) 0%, rgba(10, 14, 21, 0.95) 100%);
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    background: var(--ink);
    opacity: 0;
  }

  .hero__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: var(--nav-h);
    pointer-events: none;
  }
  .hero__eyebrow {
    margin-bottom: 1.5rem;
  }
  .hero__title {
    font-size: 18vw;
  }
  .hero__line1 {
    display: block;
    white-space: nowrap;
  }
  .hero__char {
    display: inline-block;
  }
  .hero__line2 {
    display: block;
    overflow: hidden;
    padding: 0.04em 0.1em 0.12em 0;
  }
  .hero__light {
    font-size: 0.5em; /* 9vw */
    line-height: 1;
    padding-left: 0.08em;
  }

  .hero__phrase {
    position: absolute;
    right: var(--gutter);
    bottom: calc(clamp(1.5rem, 4vh, 3rem) + 7.5rem);
    max-width: 14ch;
    margin: 0;
    text-align: right;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.25rem, 2.4vw, 2.25rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .hero__bottom {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(1.5rem, 4vh, 3rem);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .hero__lema {
    margin: 0;
    font-size: 20px;
    color: var(--text);
  }
  .hero__chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px;
    border: 1px solid var(--line);
    border-radius: var(--pill);
    background: rgba(10, 14, 21, 0.5);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    margin-inline: auto 0;
    transition: border-color 0.3s var(--ease-out);
  }
  .hero__chip:hover {
    border-color: var(--sand);
  }
  .hero__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--sand);
    box-shadow: 0 0 0 0 rgba(241, 209, 152, 0.6);
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 10px rgba(241, 209, 152, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(241, 209, 152, 0);
    }
  }
  .hero__cue {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .hero__cue-line {
    position: relative;
    width: 1px;
    height: 56px;
    background: var(--line);
    overflow: hidden;
  }
  .hero__cue-line span {
    position: absolute;
    inset: 0;
    background: var(--sand);
    transform-origin: top;
    animation: cue 2.2s var(--ease-out) infinite;
  }
  @keyframes cue {
    0% {
      transform: scaleY(0);
      transform-origin: top;
    }
    50% {
      transform: scaleY(1);
      transform-origin: top;
    }
    51% {
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }

  @media (max-width: 767px) {
    .hero__title {
      font-size: 22vw;
    }
    .hero__phrase {
      bottom: 9.5rem;
      font-size: 6.5vw;
    }
    .hero__lema {
      font-size: 17px;
    }
    .hero__bottom {
      flex-wrap: wrap;
    }
    .hero__chip {
      order: -1;
      margin: 0;
    }
    .hero__cue {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__cue {
      display: none;
    }
  }
</style>

<script>
  import { introDone, scene } from '../animations/setup';
  import { EASE } from '../animations/constants';

  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  const q = <T extends Element = HTMLElement>(s: string) => hero.querySelector<T>(s)!;
  const qa = (s: string) => hero.querySelectorAll<HTMLElement>(s);

  let entrancePlayed = false;

  scene(1, ({ gsap, c }) => {
    const img = q('.hero__img');
    const shade = q('.hero__shade');
    const fades = qa('[data-hero-fade]');

    /* ---- Reduced motion: solo un fade inicial ---- */
    if (c.reduce) {
      introDone.then(() => gsap.from(hero, { autoAlpha: 0, duration: 0.3 }));
      return;
    }

    /* ---- Entrada (timed), una sola vez ---- */
    if (!entrancePlayed) {
      entrancePlayed = true;
      const chars = qa('.hero__char');
      const light = q('.hero__light');
      gsap.set(chars, { yPercent: 110 });
      gsap.set(light, { clipPath: 'inset(0 100% 0 0)' });
      gsap.set(fades, { autoAlpha: 0, y: 20 });

      introDone.then(() => {
        const tl = gsap.timeline({ defaults: { ease: EASE.enter } });
        tl.to(chars, { yPercent: 0, duration: 1.2, stagger: 0.04 }, 0.15)
          .to(light, { clipPath: 'inset(0 0% 0 0)', duration: 1.2 }, 0.45)
          .to(fades, { autoAlpha: 1, y: 0, duration: 0.9, stagger: 0.08 }, 0.6);
      });
    }

    /* ---- Salida: sin pin; la ciudad se acerca y se oscurece ---- */
    const tl = gsap.timeline({
      defaults: { ease: EASE.scrub },
      scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: true },
    });
    tl.fromTo(img, { scale: 1 }, { scale: c.desktop ? 1.2 : 1.1 }, 0);
    tl.fromTo(shade, { opacity: 0 }, { opacity: 0.6 }, 0);
  });
</script>
