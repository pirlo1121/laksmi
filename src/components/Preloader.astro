---
import Yantra from './Yantra.astro';
import { PORTAL } from '../data/yantra';

// Tapa negra con el hueco del portal (el marco interior del yantra). Se sale del SVG
// (overflow visible) para cubrir toda la pantalla, y escala junto con el yantra.
const FAR = 20000;
const COVER = `M ${-FAR} ${-FAR} H ${FAR} V ${FAR} H ${-FAR} Z ${PORTAL}`;
---

<div class="preloader" data-preloader aria-hidden="true">
  <Yantra class="preloader__yantra">
    <path class="portal-cover" d={COVER} fill-rule="evenodd"></path>
    <path class="portal-veil" d={PORTAL}></path>
  </Yantra>
  <p class="preloader__text">Bienvenidos</p>
</div>

<style>
  /* Solo existe con JS y sin reduced-motion. */
  .preloader {
    display: none;
  }
  :global(html.js:not(.no-preloader)) .preloader {
    position: fixed;
    inset: 0;
    z-index: 950;
    display: block;
    overflow: hidden;
    background: var(--ink);
    /* Salvavidas: si el JS falla, el preloader se va solo. */
    animation: preloader-failsafe 0.4s 6s forwards;
  }
  .preloader :global(.preloader__yantra) {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(220px, 46vw);
    height: min(220px, 46vw);
    translate: -50% -50%;
    color: var(--sand);
    visibility: hidden; /* GSAP lo muestra cuando empieza a trazar */
    --yantra-stroke: 1.5px;
  }
  .portal-cover,
  .portal-veil {
    fill: var(--ink);
    stroke: none;
  }
  .preloader__text {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(50% + min(110px, 23vw) + 32px);
    margin: 0;
    text-align: center;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--text);
    opacity: 0;
  }
  @keyframes preloader-failsafe {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }
</style>

<!-- Comportamiento: scripts/preloader.ts (se importa en pages/index.astro). -->
