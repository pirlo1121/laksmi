---
import Base from '../layouts/Base.astro';
import Preloader from '../components/Preloader.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import YantraProgreso from '../components/YantraProgreso.astro';
import HoverGlow from '../components/HoverGlow.astro';
import Cifras from '../components/Cifras.astro';
import Areas from '../components/Areas/Areas.astro';
import AreasDetalle from '../components/Areas/AreasDetalle.astro';
import SeguridadSocial from '../components/SeguridadSocial.astro';
import Equipo from '../components/Equipo/Equipo.astro';
import Testimonios from '../components/Testimonios.astro';
import Contacto from '../components/Contacto/Contacto.astro';
import Footer from '../components/Footer.astro';
import Hilo from '../components/Hilo.astro';
import Cierre from '../components/Cierre.astro';
---

<Base>
  <Preloader />
  <HoverGlow />
  <Nav />
  <main id="contenido">
    <!-- Un solo hilo recorre la página: nace en la firma y termina en el logo del cierre. -->
    <Hilo />
    <Hero />
    <Cifras />
    <Areas />
    <AreasDetalle />
    <SeguridadSocial />
    <Equipo />
    <Testimonios />
    <Cierre />
    <Contacto />
  </main>
  <Footer />
  <YantraProgreso />
</Base>

<script>
  // Un solo módulo para toda la página: Astro emite un archivo por cada <script> de componente
  // (eran 15 peticiones antes del primer pintado). Van en el orden del documento.
  import '../scripts/preloader';
  import '../scripts/hover-glow';
  import '../scripts/nav';
  import '../scripts/hilo';
  import '../scripts/hero';
  import '../scripts/cifras';
  import '../scripts/areas';
  import '../scripts/areas-detalle';
  import '../scripts/seguridad-social';
  import '../scripts/equipo';
  import '../scripts/testimonios';
  import '../scripts/cierre';
  import '../scripts/consulta-form';
  import '../scripts/contacto';
  import '../scripts/yantra-progreso';
  // Arranca el orquestador (carga GSAP/Lenis y ejecuta las escenas registradas).
  import '../animations/setup';
</script>
